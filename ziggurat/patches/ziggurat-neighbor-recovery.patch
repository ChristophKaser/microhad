@@ -459,13 +459,31 @@ impl<P: RadioPhy, R: Runtime> ZigbeeStack<P, R> {
     /// discovery.
     #[allow(clippy::significant_drop_tightening)]
     pub(super) fn send_route_discovery(&self, destination: Nwk) {
+        self.send_route_discovery_until(
+            destination,
+            self.core_now() + self.tunables.route_discovery_time(),
+            self.tunables.initial_rreq_retries() + 1,
+        );
+    }
+
+    /// Recovery retries keep the original deadline and transmit only once.
+    pub(super) fn send_route_discovery_until(
+        &self,
+        destination: Nwk,
+        deadline: ziggurat_zigbee::Instant,
+        attempts: u8,
+    ) {
         tracing::debug!("Sending route discovery for NWK {destination:?}");
 
+        let now = self.core_now();
+        if deadline <= now {
+            return;
+        }
         let route_request_identifier = self.core().nib.routing.begin_discovery(
             self.state.network_address,
             destination,
-            self.core_now(),
-            self.tunables.route_discovery_time(),
+            now,
+            deadline.saturating_duration_since(now),
         );
 
         // If we know the EUI64 corresponding to the NWK, use it
@@ -488,10 +506,6 @@ impl<P: RadioPhy, R: Runtime> ZigbeeStack<P, R> {
 
         // Spec 3.6.4.5.1: the initial broadcast is repeated `nwkcInitialRREQRetries`
         // times, separated by the retry interval
-        self.broadcast_route_request(
-            route_request_frame,
-            self.tunables.initial_rreq_retries() + 1,
-            Duration::ZERO,
-        );
+        self.broadcast_route_request(route_request_frame, attempts, Duration::ZERO);
     }
 }
