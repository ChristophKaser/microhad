diff --git a/crates/ziggurat-driver/src/zigbee_stack/neighbor.rs b/crates/ziggurat-driver/src/zigbee_stack/neighbor.rs
index c14dacc..1c8f371 100644
--- a/crates/ziggurat-driver/src/zigbee_stack/neighbor.rs
+++ b/crates/ziggurat-driver/src/zigbee_stack/neighbor.rs
@@ -1,7 +1,9 @@
 use crate::runtime::Runtime;
 use alloc::vec::Vec;
+use core::time::Duration;
 use ziggurat_ieee_802154::types::{Eui64, Nwk};
 use ziggurat_phy::RadioPhy;
+use ziggurat_zigbee::Instant;
 
 use ziggurat_zigbee::nwk::commands::{NwkCommand, NwkLinkStatusCommand};
 use ziggurat_zigbee::nwk::frame::{BROADCAST_ALL_ROUTERS_AND_COORDINATOR, NwkFrame};
@@ -15,6 +17,33 @@ use super::{
 /// Maximum number of link status entries that can be carried in a single frame.
 const MAX_LINK_STATUSES: usize = 7;
 
+/// One global response slot bounds work even when many routers request recovery.
+#[derive(Debug, Default)]
+pub(crate) struct LinkRecovery {
+    due: Option<Instant>,
+    last_sent: Option<Instant>,
+}
+
+impl LinkRecovery {
+    fn schedule(&mut self, now: Instant, jitter: Duration, period: Duration) -> bool {
+        if self.due.is_some() {
+            return false;
+        }
+        let earliest = self.last_sent.map(|last| last + period).unwrap_or(now);
+        self.due = Some(core::cmp::max(now + jitter, earliest));
+        true
+    }
+
+    fn take_due(&mut self, now: Instant) -> bool {
+        if !self.due.is_some_and(|due| due <= now) {
+            return false;
+        }
+        self.due = None;
+        self.last_sent = Some(now);
+        true
+    }
+}
+
 impl<P: RadioPhy, R: Runtime> ZigbeeStack<P, R> {
     pub(super) fn maybe_recompute_lqa(&self, sender_nwk: Nwk, lqi: u8, _rssi: i8) {
         self.core().nib.neighbors.record_lqa(sender_nwk, lqi);
@@ -75,6 +104,13 @@ impl<P: RadioPhy, R: Runtime> ZigbeeStack<P, R> {
             return;
         };
 
+        let source = nwk_frame.nwk_header.source;
+        let previous_cost = self
+            .core()
+            .nib
+            .neighbors
+            .link(source)
+            .map_or(0, |link| link.outgoing_cost);
         let lost_link = self.core().nib.neighbors.on_link_status(
             self.state.network_address,
             source_ieee,
@@ -90,12 +126,47 @@ impl<P: RadioPhy, R: Runtime> ZigbeeStack<P, R> {
             self.invalidate_routes_via(neighbor_nwk);
         }
 
+        // Only a complete empty list requests bootstrap; an empty chunk does not.
+        if link_status_cmd.is_first_frame
+            && link_status_cmd.is_last_frame
+            && link_status_cmd.link_statuses.is_empty()
+        {
+            let jitter =
+                Duration::from_secs(1) + Duration::from_secs(1).mul_f32(crate::rng::random_f32());
+            if self.state.link_recovery.lock().schedule(
+                self.core_now(),
+                jitter,
+                self.tunables.link_status_period(),
+            ) {
+                tracing::debug!("Scheduling jittered link status recovery for {source:?}");
+                self.link_recovery_wake.notify_one();
+            }
+        }
+
+        let current_cost = self
+            .core()
+            .nib
+            .neighbors
+            .link(source)
+            .map_or(0, |link| link.outgoing_cost);
+        if previous_cost == 0 && current_cost > 0 {
+            tracing::debug!("Neighbor link recovered: {source:?}, outgoing_cost={current_cost}");
+            for (_, bucket) in self.state.pending_routes.lock().iter_mut() {
+                if !bucket.recovery_used {
+                    bucket.recovery_requested = true;
+                }
+            }
+            self.pending_route_wake.notify_one();
+            if self.state.is_concentrator {
+                self.mtorr_kick.notify_one();
+            }
+        }
         self.link_status_received.notify_one();
     }
 
     /// Broadcast the link status notification.
     pub fn send_link_status_broadcast(&self, empty: bool) -> SendHandle {
-        tracing::debug!("Sending periodic link status broadcast");
+        tracing::debug!("Sending link status broadcast");
 
         let (handle, slot) = SendHandle::new();
 
@@ -105,15 +176,11 @@ impl<P: RadioPhy, R: Runtime> ZigbeeStack<P, R> {
             return handle;
         }
 
-        // Decrement the `recent_activity` field of every active routing table entry
-        self.core().nib.routing.decay_activity();
-
         self.maybe_age_neighbors();
 
-        // Decrement the inbound and outbound activity fields for neighbors
+        // Snapshot the current neighbors; only the periodic task ages activity.
         let mut link_statuses = {
-            let mut core = self.core();
-            core.nib.neighbors.decay_activity();
+            let core = self.core();
 
             if empty {
                 Vec::new()
@@ -179,15 +246,62 @@ impl<P: RadioPhy, R: Runtime> ZigbeeStack<P, R> {
 
     pub async fn periodic_link_status_broadcast_task(&self) {
         let mut next = self.core_now() + self.tunables.link_status_period();
-
         loop {
-            self.sleep_until_core(next).await;
-
-            // The link status broadcast has a radius of 1 so delivery does not wait for
-            // a relay quorum.
+            let recovery = self.state.link_recovery.lock().due;
+            let deadline = recovery.map_or(next, |due| core::cmp::min(next, due));
+            let _ = self
+                .timeout_at_core(deadline, self.link_recovery_wake.notified())
+                .await;
+            let now = self.core_now();
+            let recover = self.state.link_recovery.lock().take_due(now);
+            let periodic = now >= next;
+            if !recover && !periodic {
+                continue;
+            }
+            if periodic {
+                // Extra bootstrap traffic must not accelerate activity ageing.
+                let mut core = self.core();
+                core.nib.routing.decay_activity();
+                core.nib.neighbors.decay_activity();
+                next = now + self.tunables.link_status_period();
+            }
+            if recover {
+                tracing::debug!("Sending link status recovery broadcast");
+            }
             let _ = self.send_link_status_broadcast(false).delivered().await;
+        }
+    }
+}
+
+#[cfg(test)]
+mod recovery_tests {
+    use super::*;
+    fn at(seconds: u64) -> Instant {
+        Instant::from_micros(seconds * 1_000_000)
+    }
+
+    #[test]
+    fn coalesces_without_postponing_and_limits_response_rate() {
+        let mut recovery = LinkRecovery::default();
+        let period = Duration::from_secs(15);
+        assert!(recovery.schedule(at(0), Duration::from_secs(1), period));
+        assert!(!recovery.schedule(at(0), Duration::from_secs(2), period));
+        assert_eq!(recovery.due, Some(at(1)));
+        assert!(!recovery.take_due(at(0)));
+        assert!(recovery.take_due(at(1)));
+        assert!(!recovery.take_due(at(1)));
+        assert!(recovery.schedule(at(2), Duration::from_secs(2), period));
+        assert_eq!(recovery.due, Some(at(16)));
+        assert!(!recovery.take_due(at(15)));
+        assert!(recovery.take_due(at(16)));
+    }
 
-            next = next + self.tunables.link_status_period();
+    #[test]
+    fn idle_requests_keep_the_requested_jitter() {
+        for jitter in [Duration::from_secs(1), Duration::from_secs(2)] {
+            let mut recovery = LinkRecovery::default();
+            assert!(recovery.schedule(at(20), jitter, Duration::from_secs(15)));
+            assert_eq!(recovery.due, Some(at(20) + jitter));
         }
     }
 }
