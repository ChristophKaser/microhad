+    /// Retry each still-wanted discovery once after a neighbor link recovers. Reuse
+    /// its expiry so this extra request never prolongs a held send's deadline.
+    pub fn recover_discoveries(&mut self, own_address: Nwk, now: Instant, wanted: impl Fn(Nwk) -> bool) -> Vec<(Nwk, RouteRequestId)> {
+        let destinations: Vec<Nwk> = self.discoveries_left.keys().copied().collect();
+        let mut retries = Vec::new();
+        for destination in destinations {
+            if self.recovery_retried.contains_key(&destination) || !wanted(destination) { continue; }
+            if let Some(deadline) = self.own_discovery_lapse(own_address, destination, now) {
+                self.recovery_retried.insert(destination, ());
+                let id = self.begin_discovery(own_address, destination, now, deadline.saturating_duration_since(now));
+                retries.push((destination, id));
+            }
+        }
+        retries
+    }
+
     /// When the next discovery a frame of ours waits on lapses, or `None` when none
     /// is live.
