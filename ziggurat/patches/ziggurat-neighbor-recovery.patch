                 .or_insert_with(|| PendingRoute {
                     frames: Vec::new(),
                     attempts_remaining: self.tunables.pending_route_discovery_attempts(),
+                    recovery_requested: false,
+                    recovery_used: false,
                 })
                 .frames
                 .push(PendingFrame {
@@ -977,7 +979,29 @@ impl<P: RadioPhy, R: Runtime> ZigbeeStack<P, R> {
             match self.discovery_state(destination) {
                 DiscoveryState::Resolved => self.release_queued_frames(destination),
                 DiscoveryState::Lapsed => self.retry_or_fail_discovery(destination),
-                DiscoveryState::InFlight => {}
+                DiscoveryState::InFlight => {
+                    let retry = {
+                        let mut pending = self.state.pending_routes.lock();
+                        pending.get_mut(&destination).is_some_and(|bucket| {
+                            if !bucket.recovery_requested || bucket.recovery_used {
+                                return false;
+                            }
+                            bucket.recovery_requested = false;
+                            bucket.recovery_used = true;
+                            true
+                        })
+                    };
+                    if retry {
+                        let now = self.core_now();
+                        let deadline = self.core().nib.routing.discovery_deadline(destination, now);
+                        if let Some(deadline) = deadline {
+                            tracing::debug!(
+                                "Retrying pending discovery after neighbor recovery: {destination:?}"
+                            );
+                            self.send_route_discovery_until(destination, deadline, 1);
+                        }
+                    }
+                }
             }
         }
     }
