+    pub(super) fn retry_discoveries_on_link_recovery(&self) {
+        let now = self.core_now();
+        let mut guard = self.core();
+        let core = &mut *guard;
+        let retries = core.nib.routing.recover_discoveries(self.state.network_address, now, |destination| core.sends.has_unrouted(destination));
+        let mut actions = SendActions::new();
+        for (destination, id) in retries {
+            actions.extend(self.broadcast_discovery_request(core, destination, id, 1));
+        }
+        self.commit_sends(guard, actions);
+    }
+
