+        if link_status_cmd.is_first_frame && link_status_cmd.is_last_frame && link_status_cmd.link_statuses.is_empty() {
+            let jitter = Duration::from_secs(1) + Duration::from_secs(1).mul_f32(crate::rng::random_f32());
+            if self.state.link_recovery.lock().schedule(self.core_now(), jitter, self.tunables.link_status_period()) {
+                self.link_recovery_wake.notify_one();
+            }
+        }
+        let current_cost = self.core().nib.neighbors.link(source).map_or(0, |link| link.outgoing_cost);
+        if previous_cost == 0 && current_cost > 0 {
+            self.retry_discoveries_on_link_recovery();
+            if self.state.is_concentrator { self.mtorr_kick.notify_one(); }
+        }
         self.link_status_received.notify_one();
     }
 
@@ -103,15 +141,11 @@ impl<P: RadioPhy, R: Runtime> ZigbeeStack<P, R> {
             return Err(EnqueueError::NotStarted);
         }
 
-        // Decrement the `recent_activity` field of every active routing table entry
-        self.core().nib.routing.decay_activity();
-
         self.maybe_age_neighbors();
 
-        // Decrement the inbound and outbound activity fields for neighbors
+        // Extra recovery broadcasts must not age the routing or neighbor tables.
         let mut link_statuses = {
-            let mut core = self.core();
-            core.nib.neighbors.decay_activity();
+            let core = self.core();
 
             if empty {
                 Vec::new()
@@ -177,15 +211,22 @@ impl<P: RadioPhy, R: Runtime> ZigbeeStack<P, R> {
         let mut next = self.core_now() + self.tunables.link_status_period();
 
         loop {
-            self.sleep_until_core(next).await;
-
-            // The link status broadcast has a radius of 1 so delivery does not wait for
-            // a relay quorum.
+            let recovery = self.state.link_recovery.lock().due;
+            let deadline = recovery.map_or(next, |due| core::cmp::min(next, due));
+            let _ = self.timeout_at_core(deadline, self.link_recovery_wake.notified()).await;
+            let now = self.core_now();
+            let recover = self.state.link_recovery.lock().take_due(now);
+            let periodic = now >= next;
+            if !recover && !periodic { continue; }
+            if periodic {
+                let mut core = self.core();
+                core.nib.routing.decay_activity();
+                core.nib.neighbors.decay_activity();
+                next = now + self.tunables.link_status_period();
+            }
             if let Ok(link_status) = self.send_link_status_broadcast(false) {
                 let _ = link_status.delivered().await;
             }
-
-            next = next + self.tunables.link_status_period();
         }
     }
 }
