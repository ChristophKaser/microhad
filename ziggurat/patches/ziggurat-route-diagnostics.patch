From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Gateway maintainers <gateway@example.invalid>
Date: Thu, 29 Oct 2026 18:00:00 +0100
Subject: [PATCH] Correlate route invalidation with neighbor and delivery failures

Log affected destinations and invalidation causes at info level. Summarize
neighbor outgoing-cost changes without duplicating periodic packet records.

---
diff --git a/crates/ziggurat-driver/src/zigbee_stack/neighbor.rs b/crates/ziggurat-driver/src/zigbee_stack/neighbor.rs
index 1c8f371..e6e06c2 100644
--- a/crates/ziggurat-driver/src/zigbee_stack/neighbor.rs
+++ b/crates/ziggurat-driver/src/zigbee_stack/neighbor.rs
@@ -85,7 +85,7 @@ impl<P: RadioPhy, R: Runtime> ZigbeeStack<P, R> {
         let stale_neighbors = self.core().nib.neighbors.age(self.core_now(), max_age);
 
         for neighbor_nwk in stale_neighbors {
-            self.invalidate_routes_via(neighbor_nwk);
+            self.invalidate_routes_via(neighbor_nwk, "link_status_timeout");
         }
     }
 
@@ -123,7 +123,7 @@ impl<P: RadioPhy, R: Runtime> ZigbeeStack<P, R> {
         // Spec 3.6.4.4.2: when the outgoing cost collapses to zero the link is
         // considered broken, and routes through this neighbor with it
         if let Some(neighbor_nwk) = lost_link {
-            self.invalidate_routes_via(neighbor_nwk);
+            self.invalidate_routes_via(neighbor_nwk, "link_status_lost");
         }
 
         // Only a complete empty list requests bootstrap; an empty chunk does not.
@@ -149,6 +149,14 @@ impl<P: RadioPhy, R: Runtime> ZigbeeStack<P, R> {
             .neighbors
             .link(source)
             .map_or(0, |link| link.outgoing_cost);
+        if previous_cost != current_cost {
+            tracing::info!(
+                "NEIGHBOR_LINK node={source:?} ieee={source_ieee:?} outgoing_before={previous_cost} outgoing_after={current_cost} reason=link_status entries={} first={} last={}",
+                link_status_cmd.link_statuses.len(),
+                link_status_cmd.is_first_frame,
+                link_status_cmd.is_last_frame,
+            );
+        }
         if previous_cost == 0 && current_cost > 0 {
             tracing::debug!("Neighbor link recovered: {source:?}, outgoing_cost={current_cost}");
             for (_, bucket) in self.state.pending_routes.lock().iter_mut() {
diff --git a/crates/ziggurat-driver/src/zigbee_stack/nwk.rs b/crates/ziggurat-driver/src/zigbee_stack/nwk.rs
index 6840e9d..3ce42f9 100644
--- a/crates/ziggurat-driver/src/zigbee_stack/nwk.rs
+++ b/crates/ziggurat-driver/src/zigbee_stack/nwk.rs
@@ -1426,7 +1426,7 @@ impl<P: RadioPhy, R: Runtime> ZigbeeStack<P, R> {
         }
 
         let destination = nwk_frame.nwk_header.destination;
-        self.invalidate_routes_via(next_hop);
+        self.invalidate_routes_via(next_hop, "unicast_delivery_failed");
 
         if self.core().nib.routing.remove_route_record(destination) {
             tracing::info!("Removed source route to {destination:?} after delivery failure");
@@ -1802,7 +1802,7 @@ impl<P: RadioPhy, R: Runtime> ZigbeeStack<P, R> {
     /// Zigbee spec 3.6.4.8.1: when relaying fails, the routes through the dead link are
     /// invalidated and the failure is reported back to the frame's originator.
     fn handle_relay_failure(&self, nwk_frame: &NwkFrame, next_hop: Nwk) {
-        self.invalidate_routes_via(next_hop);
+        self.invalidate_routes_via(next_hop, "relay_delivery_failed");
 
         let source = nwk_frame.nwk_header.source;
 
diff --git a/crates/ziggurat-driver/src/zigbee_stack/route.rs b/crates/ziggurat-driver/src/zigbee_stack/route.rs
index dad404e..0952c8b 100644
--- a/crates/ziggurat-driver/src/zigbee_stack/route.rs
+++ b/crates/ziggurat-driver/src/zigbee_stack/route.rs
@@ -389,8 +389,8 @@ impl<P: RadioPhy, R: Runtime> ZigbeeStack<P, R> {
         }
     }
 
-    pub(super) fn invalidate_routes_via(&self, next_hop: Nwk) {
-        self.core().nib.routing.invalidate_via(next_hop);
+    pub(super) fn invalidate_routes_via(&self, next_hop: Nwk, reason: &'static str) {
+        self.core().nib.routing.invalidate_via(next_hop, reason);
     }
 
     /// Zigbee spec 3.6.4.8.1: another router could not deliver a frame we originated;
diff --git a/crates/ziggurat-zigbee/src/nwk/neighbors.rs b/crates/ziggurat-zigbee/src/nwk/neighbors.rs
index a327218..af1b208 100644
--- a/crates/ziggurat-zigbee/src/nwk/neighbors.rs
+++ b/crates/ziggurat-zigbee/src/nwk/neighbors.rs
@@ -555,13 +555,16 @@ impl Neighbors {
 
         for neighbor in self.table.values_mut() {
             if neighbor.outgoing_cost > 0 && neighbor.last_link_status_timestamp + max_age <= now {
+                tracing::warn!(
+                    "NEIGHBOR_LINK node={:?} ieee={:?} outgoing_before={} outgoing_after=0 reason=link_status_timeout",
+                    neighbor.network_address,
+                    neighbor.extended_address,
+                    neighbor.outgoing_cost,
+                );
                 neighbor.lqas.clear();
                 neighbor.outgoing_cost = 0;
                 stale_neighbors.push(neighbor.network_address);
 
-                tracing::warn!(
-                    "Neighbor {neighbor:?} has ceased communicating, resetting link costs"
-                )
             }
         }
 
diff --git a/crates/ziggurat-zigbee/src/nwk/routing.rs b/crates/ziggurat-zigbee/src/nwk/routing.rs
index fb1206b..0b41046 100644
--- a/crates/ziggurat-zigbee/src/nwk/routing.rs
+++ b/crates/ziggurat-zigbee/src/nwk/routing.rs
@@ -267,11 +267,11 @@ impl Routing {
 
     /// Mark every active route through the given next hop as inactive, forcing a fresh
     /// discovery on next use.
-    pub fn invalidate_via(&mut self, next_hop: Nwk) {
+    pub fn invalidate_via(&mut self, next_hop: Nwk, reason: &'static str) {
         for entry in self.route_table.values_mut() {
             if entry.status == Status::Active && entry.next_hop_address == next_hop {
                 tracing::info!(
-                    "Invalidating route to {:?} via unreachable next hop {next_hop:?}",
+                    "ROUTE_INVALIDATED destination={:?} next_hop={next_hop:?} reason={reason}",
                     entry.destination
                 );
                 entry.status = Status::Inactive;
