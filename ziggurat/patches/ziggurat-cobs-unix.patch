From b701eaa1a8f3cdc56edb1b7c18b722890e0d5337 Mon Sep 17 00:00:00 2001
From: Christoph Kaser <christoph@caser.de>
Date: Wed, 7 Oct 2026 16:04:51 +0200
Subject: [PATCH] ziggurat: add COBS Unix socket transport


diff --git a/crates/ziggurat-server/src/main.rs b/crates/ziggurat-server/src/main.rs
index 254f929..6ff8502 100644
--- a/crates/ziggurat-server/src/main.rs
+++ b/crates/ziggurat-server/src/main.rs
@@ -168,6 +168,74 @@ impl ZigguratServer {
         }
     }
 
+    async fn run_cobs_unix(self: Arc<Self>, address: &str) -> std::io::Result<()> {
+        use std::os::unix::fs::{FileTypeExt, MetadataExt, PermissionsExt};
+        let path = address.strip_prefix("unix:").ok_or_else(|| {
+            std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "cobs-unix requires unix:/absolute/path",
+            )
+        })?;
+        if !std::path::Path::new(path).is_absolute() {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "socket path must be absolute",
+            ));
+        }
+        let parent = std::path::Path::new(path).parent().ok_or_else(|| {
+            std::io::Error::new(std::io::ErrorKind::InvalidInput, "socket parent missing")
+        })?;
+        if std::fs::metadata(parent)?.permissions().mode() & 0o077 != 0 {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::PermissionDenied,
+                "COBS socket requires a private parent directory",
+            ));
+        }
+        if let Ok(metadata) = std::fs::symlink_metadata(path) {
+            if !metadata.file_type().is_socket() {
+                return Err(std::io::Error::new(
+                    std::io::ErrorKind::AlreadyExists,
+                    "socket path is not a socket",
+                ));
+            }
+            match tokio::net::UnixStream::connect(path).await {
+                Err(error) if error.kind() == std::io::ErrorKind::ConnectionRefused => {
+                    let current = std::fs::symlink_metadata(path)?;
+                    if current.ino() != metadata.ino() || current.dev() != metadata.dev() {
+                        return Err(std::io::Error::new(
+                            std::io::ErrorKind::AlreadyExists,
+                            "socket changed during startup",
+                        ));
+                    }
+                    std::fs::remove_file(path)?;
+                }
+                _ => {
+                    return Err(std::io::Error::new(
+                        std::io::ErrorKind::AddrInUse,
+                        "socket already has a listener",
+                    ));
+                }
+            }
+        }
+        let listener = UnixListener::bind(path)?;
+        std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o600))?;
+        tracing::info!("Listening for COBS clients on {address}");
+        for client in 0u64.. {
+            let (socket, _) = listener.accept().await?;
+            let server = self.clone();
+            let (reader, writer) = socket.into_split();
+            tokio::spawn(async move {
+                if let Err(error) = server
+                    .handle_stream_connection(reader, writer, &format!("cobs#{client}"))
+                    .await
+                {
+                    tracing::warn!("COBS client disconnected: {error}");
+                }
+            });
+        }
+        unreachable!()
+    }
+
     async fn run_tcp(self: Arc<Self>, listen_addr: &str) -> std::io::Result<()> {
         let listener = TcpListener::bind(listen_addr).await?;
         tracing::info!("Listening for WebSocket clients on {listen_addr}");
@@ -438,14 +506,30 @@ impl ZigguratServer {
         let mut reader = reader;
         let mut buffer = [0u8; 1024];
         let mut accumulator: Vec<u8> = Vec::new();
+        let mut discarding = false;
         'read: loop {
-            let read = reader.read(&mut buffer).await?;
+            let read = match reader.read(&mut buffer).await {
+                Ok(read) => read,
+                Err(_) => break,
+            };
             if read == 0 {
                 break;
             }
             for &byte in &buffer[..read] {
                 if byte != 0 {
-                    accumulator.push(byte);
+                    if !discarding {
+                        if accumulator.len() >= 16_384 {
+                            accumulator.clear();
+                            discarding = true;
+                            tracing::warn!("Oversized COBS frame discarded");
+                        } else {
+                            accumulator.push(byte);
+                        }
+                    }
+                    continue;
+                }
+                if discarding {
+                    discarding = false;
                     continue;
                 }
                 if accumulator.is_empty() {
@@ -469,6 +553,7 @@ impl ZigguratServer {
         notification_forwarder.abort();
         send_sweeper.abort();
         drop(outbound_tx);
+        writer_task.abort();
         let _ = writer_task.await;
 
         Ok(())
@@ -1115,6 +1200,8 @@ async fn open_transport(serial: &SerialConfig) -> std::io::Result<Box<dyn RcpTra
 enum ApiMode {
     /// Binary protocol over WebSocket on `--listen`
     Ws,
+    /// COBS-framed binary protocol over a local Unix stream socket
+    CobsUnix,
     /// COBS-framed binary protocol over stdin/stdout (logs go to stderr)
     Stdio,
 }
@@ -1215,6 +1302,7 @@ fn main() -> Result<(), Box<dyn std::error::Error>> {
         match args.api {
             ApiMode::Ws => server.run(&args.listen).await?,
             ApiMode::Stdio => server.run_stdio().await?,
+            ApiMode::CobsUnix => server.run_cobs_unix(&args.listen).await?,
         }
 
         Ok(())
