+#[test]
+fn link_recovery_retries_once_without_extending_discovery() {
+    let mut routing = Routing::default();
+    let start = Instant::from_micros(0);
+    let duration = Duration::from_secs(10);
+    let first = routing.want_route(OWN, DEVICE, start, duration, 1).unwrap();
+    let at = start + Duration::from_secs(2);
+    let retried = routing.recover_discoveries(OWN, at, |destination| destination == DEVICE);
+    assert_eq!(retried.len(), 1);
+    assert_ne!(retried[0].1, first);
+    assert_eq!(routing.next_discovery_lapse(OWN, at), Some(start + duration));
+    assert!(routing.recover_discoveries(OWN, at, |_| true).is_empty());
+    routing.forget(OWN, DEVICE);
+    routing.want_route(OWN, DEVICE, at, duration, 1).unwrap();
+    assert_eq!(routing.recover_discoveries(OWN, at, |_| true).len(), 1);
+}
