+#[cfg(test)]
+mod link_recovery_tests {
+    use super::*;
+
+    #[test]
+    fn replies_are_coalesced_and_rate_limited() {
+        let mut recovery = LinkRecovery::default();
+        let start = Instant::from_micros(0);
+        let period = Duration::from_secs(15);
+        assert!(recovery.schedule(start, Duration::from_secs(1), period));
+        assert!(!recovery.schedule(start, Duration::from_secs(2), period));
+        assert!(!recovery.take_due(start));
+        assert!(recovery.take_due(start + Duration::from_secs(1)));
+        assert!(recovery.schedule(start + Duration::from_secs(2), Duration::from_secs(1), period));
+        assert!(!recovery.take_due(start + Duration::from_secs(15)));
+        assert!(recovery.take_due(start + Duration::from_secs(16)));
+    }
+}
