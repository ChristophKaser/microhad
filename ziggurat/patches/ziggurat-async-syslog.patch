         let timer = ChronoLocal::new("%Y-%m-%dT%H:%M:%S%.6f%:z".to_string());
 
@@ -1233,7 +1242,7 @@ fn main() -> Result<(), Box<dyn std::error::Error>> {
                 .with(
                     fmt::layer()
                         .with_timer(timer)
-                        .with_writer(SyslogMakeWriter)
+                        .with_writer(SyslogMakeWriter(log_writer))
                         .with_filter(filter),
                 )
                 .init();
@@ -1242,7 +1251,7 @@ fn main() -> Result<(), Box<dyn std::error::Error>> {
                 .with(
                     fmt::layer()
                         .with_timer(timer)
-                        .with_writer(SyslogMakeWriter)
+                        .with_writer(SyslogMakeWriter(log_writer))
                         .with_filter(filter),
