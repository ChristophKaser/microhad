From e8423e0e85e76b8fdbd24857409164e660c37e4d Mon Sep 17 00:00:00 2001
From: Christoph Kaser <christoph@caser.de>
Date: Wed, 7 Oct 2026 16:04:51 +0200
Subject: [PATCH] rs-matter: expose subscription attribute notifications


diff --git a/rs-matter/src/im.rs b/rs-matter/src/im.rs
index e0343b9..d52923a 100644
--- a/rs-matter/src/im.rs
+++ b/rs-matter/src/im.rs
@@ -463,6 +463,17 @@ where
     N: Networks,
     R: ReportDataHandler,
 {
+    /// Notify active subscriptions that an externally updated attribute changed.
+    pub fn notify_attr_changed(&self, endpoint_id: EndptId, cluster_id: ClusterId, attr_id: AttrId) {
+        self.handler.bump_dataver(MatchContextInstance::new(
+            Some(endpoint_id),
+            Some(cluster_id),
+        ));
+        self.state
+            .subscriptions
+            .notify_attr_changed(endpoint_id, cluster_id, attr_id);
+    }
+
     /// Create the data model with an explicit network controller `net_ctl` and a
     /// [`ReportDataHandler`] `report_handler` — the controller / subscriber role.
     ///
-- 
