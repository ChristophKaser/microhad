            v.id.present=true;
            uint64_t n;if(!pb_decode_varint(s,&n)||n>0xffffffffUL){ return false; }v.id.value=static_cast<uint32_t>(n);
            break;}
        case 5:{
            if(wt!=PB_WT_STRING){ return false; }
            if(v.body.present){ return false; }
            v.body.present=true;
            if(!readNested(s,&v.body.value,depth,unknown)){ return false; }
            break;}
        default:if(!pb_skip_field(s,wt)){ return false; }++*unknown;break;
        }
    }
    *out=v;return true;
}
