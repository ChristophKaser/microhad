--- /dev/null
+++ b/include/ziggurat_client.h
@@ -0,0 +1,90 @@
+#ifndef MICROHAD_ZIGGURAT_CLIENT_H
+#define MICROHAD_ZIGGURAT_CLIENT_H
+
+#include <deque>
+#include <map>
+#include <string>
+#include <vector>
+
+// Protocol v2: little-endian wire values, COBS messages delimited by zero.
+namespace ZigguratWire {
+typedef std::vector<unsigned char> Bytes;
+Bytes encode(const Bytes& plain);
+bool decode(const Bytes& encoded, Bytes* plain);
+unsigned long get32(const Bytes& bytes, unsigned long offset);
+void put16(Bytes* bytes, unsigned int value);
+void set32(Bytes* bytes, unsigned long offset, unsigned long value);
+}
+
+struct ZigguratState {
+    ZigguratWire::Bytes network; // 82-byte protocol NetworkState
+    ZigguratWire::Bytes keys; // counted KeyEntry table
+    ZigguratWire::Bytes children; // counted ChildEntry table
+    ZigguratWire::Bytes addresses; // counted AddressEntry table
+    bool load(const std::string& path, std::string* error);
+    bool save(const std::string& path, std::string* error) const;
+    bool valid() const;
+    bool advance(std::string* error);
+};
+
+class ZigguratClient {
+public:
+    typedef ZigguratWire::Bytes Bytes;
+    struct Event {
+        enum Type { Ready, Down, ReceivedAps, Joined, Left, Admission, Confirmation, JoinReply, Diagnostic } type;
+        unsigned int id;
+        unsigned char command;
+        unsigned char status;
+        Bytes payload;
+        std::string message;
+        Event(Type value) : type(value), id(0), command(0), status(0) {}
+    };
+    ZigguratClient();
+    ~ZigguratClient();
+    bool start(const std::string& socket, const std::string& state, std::string* error);
+    void stop();
+    void poll();
+    int fd() const { return fd_; }
+    bool needsWrite() const { return !output_.empty(); }
+    long deadline() const;
+    bool ready() const { return ready_; }
+    bool pop(Event* event);
+    unsigned int request(unsigned char command, const Bytes& payload);
+    const ZigguratState& state() const { return state_; }
+private:
+    struct Pending { unsigned char command; long expires; bool admitted; bool apsAck; Pending() : command(0), expires(0), admitted(false), apsAck(false) {} };
+    int fd_;
+    int lockFd_;
+    bool connecting_;
+    bool hello_;
+    bool ready_;
+    bool failed_;
+    bool discarding_;
+    bool stopping_;
+    bool dirtyTables_;
+    unsigned int nextId_;
+    unsigned int controlId_;
+    unsigned char phase_;
+    long reconnectAt_;
+    long helloDeadline_;
+    long checkpointAt_;
+    std::string socketPath_;
+    std::string statePath_;
+    Bytes input_;
+    Bytes output_;
+    std::map<unsigned int, Pending> pending_;
+    std::deque<Event> events_;
+    ZigguratState state_;
+    ZigguratState snapshot_;
+    unsigned long keyRevision_;
+    unsigned long snapshotRevision_;
+    bool connectSocket(std::string* error);
+    void disconnect(const std::string& reason, bool permanent = false);
+    void frame(const Bytes& data);
+    void control(unsigned char command, const Bytes& payload, unsigned char phase);
+    void controlReply(unsigned char command, unsigned char status, const Bytes& body);
+    bool persist();
+    void snapshot(bool initial);
+    void finishSnapshot();
+};
+#endif
diff --git a/paired_start.sh b/paired_start.sh
new file mode 100755
index 0000000..4141731
--- /dev/null
+++ b/paired_start.sh
@@ -0,0 +1,100 @@
+#!/bin/sh
+# Foreground paired supervisor. Not installed/activated by this task.
+# Required explicit absolute paths: ZIGGURAT_BIN, NATIVE_BIN, NATIVE_CONFIG,
+# MAINTENANCE_BIN. RUNTIME_CONTROL defaults to a private RAM directory.
+set -u
+umask 077
+: "${ZIGGURAT_BIN:?}" "${NATIVE_BIN:?}" "${NATIVE_CONFIG:?}" "${MAINTENANCE_BIN:?}"
+control=${RUNTIME_CONTROL:-/tmp/ziggurat-supervisor}
+socket_path=${ZIGGURAT_SOCKET:-/tmp/ziggurat/native.sock}
+device=${ZIGGURAT_DEVICE:-/dev/ttyS1}
+limit=${RESTART_LIMIT:-5}
+startup_limit=${STARTUP_LIMIT:-15}
+stop_limit=${STOP_LIMIT:-8}
+backoff=${RESTART_BACKOFF:-3}
+case "$limit:$startup_limit:$stop_limit:$backoff" in *[!0-9:]*|:*|*::*) exit 2;; esac
+for path in "$ZIGGURAT_BIN" "$NATIVE_BIN" "$NATIVE_CONFIG" "$MAINTENANCE_BIN" "$control" "$socket_path" "$device"; do
+    case "$path" in /*) ;; *) echo 'Absolute paths required' >&2;exit 2;; esac
+done
+# Atomic directory claim refuses stale/duplicate supervisors; operator inspects it.
+mkdir "$control" || exit 2
+printf '%s\n' "$$" > "$control/supervisor.pid"
+zig_pid=;native_pid=;retries=0;quiesced=false
+stop_child() {
+    child=$1
+    [ -n "$child" ] || return 0
+    kill -TERM "$child" 2>/dev/null || true
+    elapsed=0
+    while kill -0 "$child" 2>/dev/null && [ "$elapsed" -lt "$stop_limit" ]; do
+        sleep 1;elapsed=$((elapsed+1))
+    done
+    if kill -0 "$child" 2>/dev/null; then
+        echo 'Child stop timed out; final freeze evidence not certified' >&2
+        kill -KILL "$child" 2>/dev/null || true
+    fi
+    wait "$child" 2>/dev/null || true
+}
+cleanup() {
+    trap '' TERM INT HUP
+    trap - EXIT
+    stop_child "$native_pid";native_pid=
+    stop_child "$zig_pid";zig_pid=
+    rm -f "$control/native.pid" "$control/ziggurat.pid" "$control/supervisor.pid" "$control/quiesce" "$control/quiesced" "$control/stop"
+    # Device lacks rmdir. Only remove this invocation's known control directory.
+    rm -rf "$control"
+}
+trap 'cleanup;exit 0' TERM INT HUP
+trap cleanup EXIT
+start_zig() {
+    "$MAINTENANCE_BIN" check-free "$device" || { echo 'UART already owned or cannot be inspected' >&2;return 1; }
+    # Socket parent must be private; Ziggurat validates stale/live socket itself.
+    parent=${socket_path%/*}
+    if [ ! -d "$parent" ]; then mkdir "$parent" || return 1;chmod 700 "$parent";fi
+    "$ZIGGURAT_BIN" --device "$device" --baudrate 460800 --flow-control hardware \
+        --spinel-iid 1 --api cobs-unix --listen "unix:$socket_path" --log-level error >/dev/null 2>&1 &
+    zig_pid=$!;printf '%s\n' "$zig_pid" > "$control/ziggurat.pid"
+    deadline=$(($(date +%s)+startup_limit))
+    while [ "$(date +%s)" -lt "$deadline" ]; do
+        [ ! -e "$control/stop" ] || return 1
+        kill -0 "$zig_pid" 2>/dev/null || return 1
+        if "$MAINTENANCE_BIN" cobs-hello "$socket_path" >/dev/null 2>&1; then return 0;fi
+        sleep 1
+    done
+    echo 'API readiness deadline exceeded' >&2;return 1
+}
+start_native() {
+    "$NATIVE_BIN" --config "$NATIVE_CONFIG" >/dev/null 2>&1 &
+    native_pid=$!;printf '%s\n' "$native_pid" > "$control/native.pid"
+}
+while :; do
+    [ ! -e "$control/stop" ] || exit 0
+    if [ -e "$control/quiesce" ]; then
+        if [ "$quiesced" = false ]; then
+            stop_child "$native_pid";native_pid=
+            rm -f "$control/native.pid";: > "$control/quiesced";quiesced=true
+        fi
+        # Leave Ziggurat alive for the host freeze/export tool. No respawn.
+        sleep 1;continue
+    fi
+    if [ "$quiesced" = true ]; then
+        echo 'Quiesced state requires explicit stop and fresh supervisor start' >&2
+        exit 1
+    fi
+    if [ -z "$zig_pid" ] || ! kill -0 "$zig_pid" 2>/dev/null; then
+        stop_child "$native_pid";native_pid=
+        stop_child "$zig_pid";zig_pid=
+        if [ "$retries" -ge "$limit" ]; then echo 'Restart budget exhausted' >&2;exit 1;fi
+        retries=$((retries+1))
+        if ! start_zig; then stop_child "$zig_pid";zig_pid=;sleep "$backoff";continue;fi
+        # A concurrent maintenance request must prevent client startup.
+        [ ! -e "$control/quiesce" ] && [ ! -e "$control/stop" ] || continue
+        start_native
+    elif [ -z "$native_pid" ] || ! kill -0 "$native_pid" 2>/dev/null; then
+        stop_child "$native_pid";native_pid=
+        if [ "$retries" -ge "$limit" ]; then echo 'Restart budget exhausted' >&2;exit 1;fi
+        retries=$((retries+1));sleep "$backoff"
+        [ ! -e "$control/quiesce" ] && [ ! -e "$control/stop" ] || continue
+        start_native
+    fi
+    sleep 1
+done
diff --git a/scripts/ezsp_final_capture.py b/scripts/ezsp_final_capture.py
new file mode 100644
index 0000000..cbfd589
--- /dev/null
+++ b/scripts/ezsp_final_capture.py
@@ -0,0 +1,183 @@
+#!/usr/bin/env python3
+"""Exclusive EZSP v13 final read-only capture, optionally enter bootloader immediately.
+
+Default validates the comparison export offline. Live mode requires the native
+supervisor/daemon stopped and exactly one inspected serial bridge owning UART.
+No flash, network formation, joining, key or counter write commands are issued.
+After the connection reset, networkInit may resume the existing token-backed
+network. This can transmit; capture must follow initialization on this connection.
+"""
+import argparse
+import asyncio
+from collections import deque
+from datetime import datetime, timezone
+import json
+import logging
+from pathlib import Path
+
+from network_backup import normalize, private_write, ssh_args
+
+
+def compare(original, final):
+    for field in ('ieee_address', 'pan_id', 'extended_pan_id', 'channel', 'network_key',
+                  'network_key_seq', 'tc_link_key', 'tclk_seed', 'tclk_flavor'):
+        if original['network'][field] != final['network'][field]:
+            raise ValueError('identity or security changed before exclusive handover')
+    for field in ('network_key_tx_counter', 'aps_frame_counter'):
+        if final['network'][field] < original['network'][field]:
+            raise ValueError('final counter regressed')
+    if not final['counter_evidence']['aps_live_upper_bound_verified']:
+        raise ValueError('live APS counter evidence missing')
+
+
+def raw_read_protocol(ezsp):
+    # Error replies from this NCP can contain only status, while Bellows' typed
+    # schemas expect a full row. Preserve bounded raw replies for our existing
+    # strict exporter decoder instead of timing out on empty slots.
+    class RawResponse:
+        @classmethod
+        def deserialize(cls, data):
+            if len(data)>4096:
+                raise ValueError("response bound")
+            return bytes(data), b""
+    protocol=ezsp._protocol
+    protocol.COMMANDS=dict(protocol.COMMANDS)
+    for name,(cid,tx,rx) in list(protocol.COMMANDS.items()):
+        if cid in (0x26,0x27,0x28,0x69,0x116,0x91,0x114,0x52,0x10c,0x100,0x101,0x102,0x10f,0x4a):
+            protocol.COMMANDS[name]=(cid,tx,RawResponse)
+            protocol.COMMANDS_BY_ID[cid]=(name,tx,RawResponse)
+
+
+async def resume_existing_network(ezsp):
+    import bellows.types as t
+    state, = await asyncio.wait_for(ezsp.networkState(),10)
+    if state == t.EmberNetworkStatus.NO_NETWORK:
+        # The retained NCP boots with stack profile 0; production sets Zigbee
+        # PRO profile 2 before networkInit. These are runtime settings only.
+        for config, value in ((t.EzspConfigId.CONFIG_SECURITY_LEVEL,5),
+                              (t.EzspConfigId.CONFIG_STACK_PROFILE,2)):
+            status, = await asyncio.wait_for(ezsp.setConfigurationValue(config,value),10)
+            if int(status):
+                raise ValueError('saved-network runtime configuration failed')
+        status, = await asyncio.wait_for(ezsp.networkInit(networkInitBitmask=t.EmberNetworkInitBitmask(0)),10)
+        if status != t.EmberStatus.SUCCESS:
+            raise ValueError('persisted network initialization failed; formation forbidden')
+        for _ in range(20):
+            state, = await asyncio.wait_for(ezsp.networkState(),10)
+            if state == t.EmberNetworkStatus.JOINED_NETWORK:
+                break
+            await asyncio.sleep(0.1)
+    if state != t.EmberNetworkStatus.JOINED_NETWORK:
+        raise ValueError('existing network is not joined; formation forbidden')
+
+
+async def capture(ezsp):
+    from bellows.ezsp.v13.commands import COMMANDS
+    import bellows.types as t
+    names = {cid: name for name, (cid, _, _) in COMMANDS.items()}
+    empty = b''
+    queries = deque([(0x26, empty), (0x27, empty), (0x28, empty), (0x69, empty),
+                     (0x116, empty), (0x91, empty), (0x114, b'\x01'+bytes(17)),
+                     (0x114, b'\x02'+bytes(17)), (0x52, b'\x1e'), (0x52, b'\x11'),
+                     (0x52, b'\x0d'), (0x10c, b'\x02'+bytes(17)), (0x100, empty)])
+    raw = {'format':'microhad-ezsp-export', 'version':1, 'ezsp_version':13, 'records':[]}
+    async def query(cid, payload):
+        name = names[cid]; _, tx, rx = COMMANDS[name]
+        values = []; tail = payload
+        for typ in tx.values():
+            value, tail = typ.deserialize(tail); values.append(value)
+        if tail:
+            raise ValueError('trailing request data')
+        result = await asyncio.wait_for(getattr(ezsp, name)(*values), 10)
+        if isinstance(result,bytes):
+            response=result
+        elif isinstance(rx, dict):
+            response = b''.join(typ(value).serialize() for typ, value in zip(rx.values(), result))
+        else:
+            response = result.serialize()
+        raw['records'].append({'command':cid,'request':payload.hex(),'response':response.hex()})
+        return response
+    while queries:
+        if len(raw['records']) > 2048:
+            raise ValueError('query limit')
+        cid, payload = queries.popleft(); response = await query(cid, payload)
+        if cid == 0x52 and payload != b'\x0d':
+            if len(response)!=3 or response[0] or response[2]:
+                raise ValueError('invalid table size')
+            queries.extend((0x10f if payload==b'\x1e' else 0x4a, bytes([i]))
+                           for i in range(response[1]))
+        elif cid == 0x100:
+            if len(response)!=1:
+                raise ValueError('invalid token count')
+            queries.extend((0x101, bytes([i])) for i in range(response[0]))
+        elif cid == 0x101:
+            if response==b'\xb5':
+                queries = deque((c,p) for c,p in queries if c!=0x101)
+            elif len(response)==9 and response[0]==0:
+                queries.extend((0x102, response[1:5]+i.to_bytes(4,'little'))
+                               for i in range(response[8]))
+            else:
+                raise ValueError('invalid token metadata')
+    for cid, payload in [(0x28,empty),(0x69,empty),(0x116,empty),(0x26,empty),
+                         (0x114,b'\x01'+bytes(17)),(0x114,b'\x02'+bytes(17)),
+                         (0x10c,b'\x02'+bytes(17))]:
+        await query(cid,payload)
+    raw['complete']=True;raw['collected_at']=datetime.now(timezone.utc).isoformat()
+    normalize(raw)  # validate before publishing
+    return raw
+
+
+async def live(args, original):
+    import bellows.ezsp
+    import subprocess
+    import shlex
+    # A device-side ownership check before connecting; fails if service/supervisor
+    # maintenance has not established the exact bridge as sole UART owner.
+    stopped = f"awk '$1 == \"State:\" {{if ($2 != \"T\") exit 1; found=1}} END {{if (!found) exit 1}}' /proc/{args.supervisor_pid}/status"
+    subprocess.run(ssh_args(args)+[stopped],check=True,stdout=subprocess.DEVNULL,timeout=10)
+    command = shlex.join([args.maintenance, 'check-owner', '/dev/ttyS1', str(args.bridge_pid)])
+    subprocess.run(ssh_args(args)+[command],check=True,stdout=subprocess.DEVNULL,timeout=10)
+    ezsp = bellows.ezsp.EZSP({'path':f'socket://{args.host}:{args.port}',
+                            'baudrate':115200,'flow_control':'hardware'})
+    try:
+        await ezsp.connect(use_thread=False)
+        if ezsp.ezsp_version != 13:
+            raise ValueError('EZSP v13 required')
+        await resume_existing_network(ezsp)
+        raw_read_protocol(ezsp)
+        raw = await asyncio.wait_for(capture(ezsp),120)
+        compare(original,normalize(raw))
+        private_write(args.output,(json.dumps(raw,indent=2)+'\n').encode())
+        if args.enter_bootloader:
+            status, = await asyncio.wait_for(ezsp.launchStandaloneBootloader(mode=1),10)
+            if int(status):
+                raise ValueError('bootloader entry refused; refresh evidence before retry')
+        print('Private final capture saved'+('; bootloader entry accepted' if args.enter_bootloader else '; refresh before later cutover'))
+    finally:
+        await asyncio.wait_for(ezsp.disconnect(),10)
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--compare',required=True);p.add_argument('--output')
+    p.add_argument('--host');p.add_argument('--port',type=int,default=8888)
+    p.add_argument('--password-file');p.add_argument('--bridge-pid',type=int)
+    p.add_argument('--supervisor-pid',type=int)
+    p.add_argument('--maintenance',default='/tuya/ziggurat-stage/gateway-maintenance')
+    p.add_argument('--exclusive-radio',action='store_true');p.add_argument('--capture',action='store_true')
+    p.add_argument('--enter-bootloader',action='store_true')
+    args=p.parse_args();original=normalize(json.loads(Path(args.compare).read_text()))
+    if not args.capture:
+        print('Comparison export validated offline; no radio connection');return
+    if not all((args.host,args.password_file,args.bridge_pid,args.supervisor_pid,args.exclusive_radio,args.output)):
+        p.error('capture requires host/password-file/bridge-pid/exclusive-radio/output')
+    if args.bridge_pid<=1 or args.supervisor_pid<=1 or Path(args.output).exists() or Path(args.output).parent.stat().st_mode&0o077:
+        p.error('invalid bridge PID or private output')
+    logging.getLogger('bellows').setLevel(logging.CRITICAL)
+    asyncio.run(asyncio.wait_for(live(args,original),160))
+
+
+if __name__=='__main__':
+    try:main()
+    except Exception:
+        raise SystemExit('Final capture failed; no handover certified')
