+unsafe extern "C" {
+    fn openlog(ident: *const c_char, option: c_int, facility: c_int);
+    fn syslog(priority: c_int, format: *const c_char, ...);
+}
+
+const LOG_INFO: c_int = 6;
+const LOG_DAEMON: c_int = 3 << 3;
+const LOG_PID: c_int = 1;
+
+struct SyslogWriter(Vec<u8>);
+
+impl SyslogWriter {
+    fn emit(&mut self) {
+        if self.0.is_empty() {
+            return;
+        }
+        let line = String::from_utf8_lossy(&self.0).replace('\0', "?");
+        if let Ok(message) = CString::new(line) {
+            unsafe {
+                syslog(LOG_DAEMON | LOG_INFO, b"%s\0".as_ptr() as *const _, message.as_ptr());
+            }
+        }
+        self.0.clear();
+    }
+}
+
+impl Write for SyslogWriter {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        for byte in bytes {
+            if *byte == b'\n' {
+                self.emit();
+            } else if self.0.len() < 4096 {
+                self.0.push(*byte);
+            }
+        }
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        self.emit();
+        Ok(())
+    }
+}
+
+impl Drop for SyslogWriter {
+    fn drop(&mut self) {
+        self.emit();
+    }
+}
+
+struct SyslogMakeWriter;
+impl<'a> tracing_subscriber::fmt::MakeWriter<'a> for SyslogMakeWriter {
+    type Writer = SyslogWriter;
+    fn make_writer(&'a self) -> Self::Writer {
+        SyslogWriter(Vec::new())
+    }
+}
