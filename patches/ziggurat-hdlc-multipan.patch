-            protocol: Arc::new(Mutex::new(SpinelProtocol::new())),
-            exclusive_lock: AsyncMutex::new(()),
+            protocol,
+            network_link_id: iid,
+            reset_owner: true,
             consecutive_timeouts: AtomicU32::new(0),
+        })
+    }
