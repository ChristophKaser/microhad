+    /// Create the physical UART owner, normally IID 1 in a multi-PAN build.
+    pub fn new_for_interface(port: Box<dyn RcpTransport>, iid: u8) -> Result<Self, SpinelError> {
+        if iid > 3 {
+            return Err(SpinelError::InvalidInterface(iid));
+        }
+        let (reader, writer) = tokio::io::split(port);
+        let protocol = Arc::new(Mutex::new(SpinelProtocol::for_interface(iid)));
+        let protocols = Arc::new(Mutex::new(HashMap::from([(iid, Arc::clone(&protocol))])));
+        Ok(Self {
+            link: Arc::new(SpinelLink {
+                reader: Mutex::new(Some(reader)),
+                writer: AsyncMutex::new(SpinelWriter {
+                    port: writer,
+                    frame_scratch: Vec::with_capacity(SPINEL_FRAME_MAX_SIZE),
+                    hdlc_scratch: Vec::with_capacity(2 * SPINEL_FRAME_MAX_SIZE + 2),
+                }),
+                protocols,
+                exclusive_lock: AsyncMutex::new(()),
+                channel: Mutex::new(None),
