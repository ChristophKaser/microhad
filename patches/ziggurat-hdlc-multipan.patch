     ) -> Result<SpinelStatus, SpinelError> {
-        let _exclusive_lock = self.exclusive_lock.lock().await;
+        let _exclusive_lock = self.link.exclusive_lock.lock().await;
         self.transmit_frame_inner(tx_frame).await
     }
 
@@ -578,3 +796,27 @@ impl ExclusiveRadio<'_> {
         self.client.transmit_frame_inner(tx_frame).await
     }
 }
+
+fn global_reset_status(frame: &SpinelFrame) -> Option<SpinelStatus> {
+    if frame.header.transaction_id != 0 || frame.command_id != SpinelCommandId::PropValueIs {
+        return None;
+    }
+    let (property, value) = packed_uint21_deserialize(&frame.payload).ok()?;
+    if property != SpinelPropertyId::LastStatus as u32 {
+        return None;
+    }
+    let (status, _) = packed_uint21_deserialize(value).ok()?;
+    let status = SpinelStatus::try_from(u8::try_from(status).ok()?).ok()?;
+    status.is_reset().then_some(status)
+}
+
+async fn write_hdlc<T: AsyncWrite + Unpin>(
+    stream: &mut T,
+    frame: &SpinelFrame,
+) -> Result<(), SpinelError> {
+    let mut bytes = vec![HdlcSpecial::Flag as u8];
+    hdlc_escape_into(&frame.to_bytes(), &mut bytes);
+    bytes.push(HdlcSpecial::Flag as u8);
+    stream.write_all(&bytes).await?;
+    Ok(())
+}
