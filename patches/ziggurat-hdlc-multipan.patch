-        let new_phy = Arc::new(SpinelPhy::new(Arc::new(SpinelClient::new(transport))));
+        let client = Arc::new(
+            SpinelClient::new_for_interface(transport, self.serial.spinel_iid)
+                .map_err(std::io::Error::other)?,
+        );
+        if let Some(path) = &self.serial.thread_socket {
+            use std::os::unix::fs::PermissionsExt;
+            let thread = client.interface(2).map_err(std::io::Error::other)?;
+            let listener = UnixListener::bind(path)?;
+            std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o600))?;
+            tracing::info!("Local Thread HDLC endpoint: {path} (IID 0 translated to RCP IID 2)");
+            tokio::spawn(async move {
+                loop {
+                    match listener.accept().await {
+                        Ok((stream, _)) => {
+                            if let Err(error) = thread.serve_hdlc(stream).await {
+                                tracing::warn!("Thread endpoint disconnected: {error}");
+                            }
+                        }
+                        Err(error) => {
+                            tracing::error!("Thread listener failed: {error}");
+                            break;
+                        }
+                    }
+                }
+            });
+        }
+        let new_phy = Arc::new(SpinelPhy::new(client));
