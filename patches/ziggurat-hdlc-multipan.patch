+    /// Register another network on the same reader/writer. It cannot reset the RCP.
+    pub fn interface(&self, iid: u8) -> Result<Self, SpinelError> {
+        let mut protocols = self
+            .link
+            .protocols
+            .lock()
+            .expect("Failed to lock interfaces");
+        if iid == 0 || iid > 3 || self.network_link_id == 0 || protocols.contains_key(&iid) {
+            return Err(SpinelError::InvalidInterface(iid));
         }
+        let protocol = Arc::new(Mutex::new(SpinelProtocol::for_interface(iid)));
+        protocols.insert(iid, Arc::clone(&protocol));
+        Ok(Self {
+            link: Arc::clone(&self.link),
+            protocol,
+            network_link_id: iid,
+            reset_owner: false,
+            consecutive_timeouts: AtomicU32::new(0),
+        })
+    }
