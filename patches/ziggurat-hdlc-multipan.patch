+++ b/crates/ziggurat-spinel/tests/multipan.rs
@@ -0,0 +1,244 @@
+use std::collections::VecDeque;
+use std::sync::Arc;
+use tokio::io::{AsyncReadExt, DuplexStream};
+use tokio::sync::mpsc;
+use tokio::time::{Duration, timeout};
+use ziggurat_spinel::client::{SpinelClient, SpinelError};
+use ziggurat_spinel::{
+    SpinelCommandId as Cmd, SpinelFrame, SpinelHeader, SpinelPropertyId as Prop, SpinelProtocol,
+    SpinelStatus, packed_uint21_to_bytes,
+};
+
+struct Peer {
+    stream: DuplexStream,
+    decoder: SpinelProtocol,
+    frames: VecDeque<SpinelFrame>,
+}
+impl Peer {
+    fn new(stream: DuplexStream) -> Self {
+        Self {
+            stream,
+            decoder: SpinelProtocol::new(),
+            frames: VecDeque::new(),
+        }
+    }
+    async fn read(&mut self) -> SpinelFrame {
+        timeout(Duration::from_secs(1), async {
+            loop {
+                if let Some(frame) = self.frames.pop_front() {
+                    return frame;
+                }
+                let mut bytes = [0; 2048];
+                let n = self.stream.read(&mut bytes).await.unwrap();
+                assert!(n > 0);
+                self.frames
+                    .extend(self.decoder.parse_frames_from_bytes(&bytes[..n]));
+            }
+        })
+        .await
+        .expect("framed response")
+    }
+    async fn send(&mut self, frame: &SpinelFrame) {
+        use tokio::io::AsyncWriteExt;
+        let mut bytes = vec![0x7e];
+        ziggurat_spinel::hdlc_escape_into(&frame.to_bytes(), &mut bytes);
+        bytes.push(0x7e);
+        self.stream.write_all(&bytes).await.unwrap();
+    }
+}
+fn notification(iid: u8, prop: Prop, value: &[u8]) -> SpinelFrame {
+    SpinelFrame {
+        header: SpinelHeader {
+            flag: 2,
+            network_link_id: iid,
+            transaction_id: 0,
+        },
+        command_id: Cmd::PropValueIs,
+        payload: [packed_uint21_to_bytes(prop as u32), value.to_vec()].concat(),
+    }
+}
+fn setup() -> (Arc<SpinelClient>, Arc<SpinelClient>, Peer) {
+    let (host, peer) = tokio::io::duplex(8192);
+    let zigbee = Arc::new(SpinelClient::new_for_interface(Box::new(host), 1).unwrap());
+    let thread = Arc::new(zigbee.interface(2).unwrap());
+    zigbee.spawn_reader();
+    thread.spawn_reader(); // Idempotent; never starts a second physical reader.
+    (zigbee, thread, Peer::new(peer))
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn same_tid_reversed_responses_and_unknown_iid_are_isolated() {
+    let (zigbee, thread, mut peer) = setup();
+    let z = tokio::spawn(async move { zigbee.prop_value_get(Prop::NcpVersion).await });
+    let t = tokio::spawn(async move { thread.prop_value_get(Prop::NcpVersion).await });
+    let a = peer.read().await;
+    let b = peer.read().await;
+    assert_ne!(a.header.network_link_id, b.header.network_link_id);
+    assert_eq!(a.header.transaction_id, b.header.transaction_id);
+    let mut wrong = notification(3, Prop::NcpVersion, b"wrong");
+    wrong.header.transaction_id = a.header.transaction_id;
+    peer.send(&wrong).await;
+    tokio::task::yield_now().await;
+    assert!(!z.is_finished() && !t.is_finished());
+    for request in [b, a] {
+        let value = if request.header.network_link_id == 1 {
+            b"zigbee".as_slice()
+        } else {
+            b"thread".as_slice()
+        };
+        let mut reply = notification(request.header.network_link_id, Prop::NcpVersion, value);
+        reply.header.transaction_id = request.header.transaction_id;
+        peer.send(&reply).await;
+    }
+    assert_eq!(z.await.unwrap().unwrap(), b"zigbee");
+    assert_eq!(t.await.unwrap().unwrap(), b"thread");
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn receive_notifications_stay_on_their_interface() {
+    let (zigbee, thread, mut peer) = setup();
+    let (ztx, mut zrx) = mpsc::channel(4);
+    let (ttx, mut trx) = mpsc::channel(4);
+    zigbee.set_property_update_receiver(Prop::StreamRaw, ztx);
+    thread.set_property_update_receiver(Prop::StreamRaw, ttx);
+    peer.send(&notification(2, Prop::StreamRaw, b"thread frame"))
+        .await;
+    assert_eq!(
+        timeout(Duration::from_secs(1), trx.recv())
+            .await
+            .unwrap()
+            .unwrap()
+            .value,
+        b"thread frame"
+    );
+    assert!(zrx.try_recv().is_err());
+    peer.send(&notification(1, Prop::StreamRaw, b"zigbee frame"))
+        .await;
+    assert_eq!(
+        timeout(Duration::from_secs(1), zrx.recv())
+            .await
+            .unwrap()
+            .unwrap()
+            .value,
+        b"zigbee frame"
+    );
+    assert!(trx.try_recv().is_err());
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn owner_reset_targets_active_interface_not_reserved_broadcast() {
+    let (zigbee, _, mut peer) = setup();
+    zigbee.send_reset(ziggurat_spinel::SpinelResetReason::Stack).await.unwrap();
+    let frame = peer.read().await;
+    assert_eq!(frame.header.network_link_id, 1);
+    assert_eq!(frame.command_id, Cmd::Reset);
+    assert_eq!(frame.payload, vec![ziggurat_spinel::SpinelResetReason::Stack as u8]);
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn physical_reset_cancels_both_interfaces_and_secondary_cannot_reset() {
+    let (zigbee, thread, mut peer) = setup();
+    assert!(matches!(
+        thread
+            .send_reset(ziggurat_spinel::SpinelResetReason::Stack)
+            .await,
+        Err(SpinelError::ResetNotOwner)
+    ));
+    let (ztx, mut zrx) = mpsc::channel(4);
+    let (ttx, mut trx) = mpsc::channel(4);
+    zigbee.set_reset_notification_receiver(ztx);
+    thread.set_reset_notification_receiver(ttx);
+    let z = tokio::spawn(async move { zigbee.prop_value_get(Prop::NcpVersion).await });
+    let t = tokio::spawn(async move { thread.prop_value_get(Prop::NcpVersion).await });
+    peer.read().await;
+    peer.read().await;
+    peer.send(&notification(0, Prop::LastStatus, &[114])).await;
+    assert!(matches!(
+        z.await.unwrap(),
+        Err(SpinelError::CancelledByReset)
+    ));
+    assert!(matches!(
+        t.await.unwrap(),
+        Err(SpinelError::CancelledByReset)
+    ));
+    assert!(zrx.recv().await.unwrap().is_reset());
+    assert!(trx.recv().await.unwrap().is_reset());
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn shared_settings_are_rejected_without_leaking_pending_requests() {
+    let (zigbee, thread, mut peer) = setup();
+    let z = Arc::clone(&zigbee);
+    let request = tokio::spawn(async move { z.prop_value_set(Prop::PhyChan, vec![15]).await });
+    let frame = peer.read().await;
+    peer.send(&SpinelFrame {
+        command_id: Cmd::PropValueIs,
+        ..frame
+    })
+    .await;
+    request.await.unwrap().unwrap();
+    for (property, value) in [
+        (Prop::PhyChan, vec![20]),
+        (Prop::MacPromiscuousMode, vec![1]),
+        (Prop::MacSrcMatchEnabled, vec![0]),
+        (Prop::MacScanState, vec![1]),
+        (Prop::PhyEnabled, vec![0]),
+        (Prop::MacRxOnWhenIdleMode, vec![0]),
+    ] {
+        assert!(matches!(
+            thread.prop_value_set(property, value).await,
+            Err(SpinelError::SharedSettingDenied(_))
+        ));
+    }
+    assert!(thread.protocol.lock().unwrap().pending_frames.is_empty());
+    assert!(matches!(
+        zigbee.interface(2),
+        Err(SpinelError::InvalidInterface(2))
+    ));
+    assert!(matches!(
+        zigbee.interface(0),
+        Err(SpinelError::InvalidInterface(0))
+    ));
+}
+
+#[tokio::test(flavor = "current_thread")]
+async fn local_hdlc_endpoint_translates_iid_and_preserves_consumer_tid() {
+    let (_zigbee, thread, mut radio) = setup();
+    let (endpoint, local) = tokio::io::duplex(8192);
+    let task = tokio::spawn(async move { thread.serve_hdlc(endpoint).await });
+    let mut local = Peer::new(local);
+    let request = SpinelFrame {
+        header: SpinelHeader {
+            flag: 2,
+            network_link_id: 0,
+            transaction_id: 7,
+        },
+        command_id: Cmd::PropValueGet,
+        payload: packed_uint21_to_bytes(Prop::NcpVersion as u32),
+    };
+    local.send(&request).await;
+    let forwarded = radio.read().await;
+    assert_eq!(forwarded.header.network_link_id, 2);
+    assert_eq!(forwarded.header.transaction_id, 1);
+    let mut response = notification(2, Prop::NcpVersion, b"RCP");
+    response.header.transaction_id = 1;
+    radio.send(&response).await;
+    let reply = local.read().await;
+    assert_eq!(reply.header, request.header);
+    radio
+        .send(&notification(2, Prop::StreamRaw, b"incoming"))
+        .await;
+    assert_eq!(local.read().await.header.network_link_id, 0);
+    local
+        .send(&SpinelFrame {
+            command_id: Cmd::Reset,
+            payload: vec![2],
+            ..request
+        })
+        .await;
+    let rejected = local.read().await;
+    assert_eq!(rejected.payload, vec![0, SpinelStatus::InvalidState as u8]);
+    radio.send(&notification(0, Prop::LastStatus, &[114])).await;
+    assert_eq!(local.read().await.payload, vec![0, 114]);
+    task.abort();
+}
