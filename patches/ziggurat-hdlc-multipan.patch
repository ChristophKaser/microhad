+    /// Shared MG1 policy: one channel, normal filtering, source matching enabled.
+    /// Scans are denied while two interfaces are registered because they retune RX.
+    fn check_shared_setting(
+        &self,
+        command: SpinelCommandId,
+        payload: &[u8],
+    ) -> Result<(), SpinelError> {
+        if self
+            .link
+            .protocols
+            .lock()
+            .expect("Failed to lock interfaces")
+            .len()
+            < 2
+            || command != SpinelCommandId::PropValueSet
+        {
+            return Ok(());
+        }
+        let (property, value) = packed_uint21_deserialize(payload)?;
+        if (property == SpinelPropertyId::PhyEnabled as u32
+            || property == SpinelPropertyId::MacRxOnWhenIdleMode as u32)
+            && value != [1]
+        {
+            return Err(SpinelError::SharedSettingDenied(
+                "both PANs require the radio receiving",
+            ));
+        }
+        if property == SpinelPropertyId::MacPromiscuousMode as u32 && value != [0] {
+            return Err(SpinelError::SharedSettingDenied("promiscuous mode"));
+        }
+        if property == SpinelPropertyId::MacSrcMatchEnabled as u32 && value != [1] {
+            return Err(SpinelError::SharedSettingDenied(
+                "source matching must stay enabled",
+            ));
+        }
+        if property == SpinelPropertyId::MacScanState as u32 && value != [0] {
+            return Err(SpinelError::SharedSettingDenied(
+                "scan coordination is not implemented",
+            ));
+        }
+        if property == SpinelPropertyId::PhyChan as u32 {
+            if value.len() != 1 {
+                return Err(SpinelError::SharedSettingDenied("invalid channel"));
+            }
+            let mut channel = self.link.channel.lock().expect("Failed to lock channel");
+            if channel.is_some_and(|current| current != value[0]) {
+                return Err(SpinelError::SharedSettingDenied(
+                    "both PANs must use the same channel",
+                ));
+            }
+            *channel = Some(value[0]);
+        }
+        Ok(())
+    }
+
+    /// Local HDLC endpoint for one Thread consumer. Its IID 0 is translated to
+    /// this client's IID; resets are rejected, and global reset events are relayed.
+    /// Use otbr-agent's no-reset option and a transport adapter for a Unix socket.
+    pub async fn serve_hdlc<T: AsyncRead + AsyncWrite + Send + Unpin>(
+        &self,
+        mut stream: T,
+    ) -> Result<(), SpinelError> {
+        let (tx, mut notifications) = mpsc::channel(256);
+        self.set_unsolicited_frame_receiver(tx);
+        let mut decoder = SpinelProtocol::new();
+        let mut buffer = [0u8; 2048];
+        loop {
+            tokio::select! {
+                frame = notifications.recv() => {
+                    let Some(mut frame) = frame else { return Err(SpinelError::TransportClosed); };
+                    frame.header.network_link_id = 0;
+                    write_hdlc(&mut stream, &frame).await?;
+                }
+                read = stream.read(&mut buffer) => {
+                    let n = read?;
+                    if n == 0 { return Ok(()); }
+                    for frame in decoder.parse_frames_from_bytes(&buffer[..n]) {
+                        if frame.command_id == SpinelCommandId::Noop { continue; }
+                        let header = frame.header;
+                        let result = if header.network_link_id != 0 {
+                            Err(SpinelError::InvalidInterface(header.network_link_id))
+                        } else if frame.command_id == SpinelCommandId::Reset {
+                            Err(SpinelError::ResetNotOwner)
+                        } else {
+                            let _radio = self.link.exclusive_lock.lock().await;
+                            self.send_command(frame.command_id, frame.payload).await
+                        };
+                        let response = match result {
+                            Ok(mut response) => { response.header = header; response }
+                            Err(error) => {
+                                tracing::warn!("Thread endpoint request rejected: {error}");
+                                let status = match error {
+                                    SpinelError::InvalidInterface(_) => SpinelStatus::InvalidInterface,
+                                    SpinelError::ResetNotOwner | SpinelError::CancelledByReset => SpinelStatus::InvalidState,
+                                    SpinelError::SharedSettingDenied(_) => SpinelStatus::InvalidArgument,
+                                    _ => SpinelStatus::Failure,
+                                };
+                                SpinelFrame {
+                                    header, command_id: SpinelCommandId::PropValueIs,
+                                    payload: [packed_uint21_to_bytes(SpinelPropertyId::LastStatus as u32),
+                                        packed_uint21_to_bytes(status as u32)].concat(),
+                                }
+                            }
+                        };
+                        write_hdlc(&mut stream, &response).await?;
+                    }
+                }
+            }
+        }
+    }
+
     pub async fn prop_value_get(
         &self,
         property_id: SpinelPropertyId,
@@ -502,7 +720,7 @@ impl SpinelClient {
     pub async fn lock_radio(&self) -> ExclusiveRadio<'_> {
         ExclusiveRadio {
             client: self,
-            _guard: self.exclusive_lock.lock().await,
