From 45aa3d97a2d4d63f9fb9d325cb94354a78db7e08 Mon Sep 17 00:00:00 2001
From: Christoph Kaser <christoph@caser.de>
Date: Wed, 7 Oct 2026 16:04:53 +0200
Subject: [PATCH] openthread: add Unix socket HDLC transport

---
 src/lib/spinel/spinel_driver.cpp      | 15 +++++++++--
 src/lib/spinel/spinel_driver.hpp      |  3 ++-
 src/posix/platform/hdlc_interface.cpp | 39 ++++++++++++++++++++++++---
 src/posix/platform/radio_url.cpp      |  1 +
 src/posix/platform/spinel_manager.cpp |  3 ++-
 5 files changed, 54 insertions(+), 7 deletions(-)

diff --git a/src/lib/spinel/spinel_driver.cpp b/src/lib/spinel/spinel_driver.cpp
index 31c8a9672..8e83a28c7 100644
--- a/src/lib/spinel/spinel_driver.cpp
+++ b/src/lib/spinel/spinel_driver.cpp
@@ -66,7 +66,8 @@ SpinelDriver::SpinelDriver(void)
 CoprocessorType SpinelDriver::Init(SpinelInterface    &aSpinelInterface,
                                    bool                aSoftwareReset,
                                    const spinel_iid_t *aIidList,
-                                   uint8_t             aIidListLength)
+                                   uint8_t             aIidListLength,
+                                   bool                aAttachToRunningRcp)
 {
     CoprocessorType coprocessorType;
 
@@ -83,7 +84,17 @@ CoprocessorType SpinelDriver::Init(SpinelInterface    &aSpinelInterface,
     }
     mIid = aIidList[0];
 
-    ResetCoprocessor(aSoftwareReset);
+    if (aAttachToRunningRcp)
+    {
+        // An already-running shared RCP will not replay its boot notification.
+        // Verify readiness through the following protocol/version/capability queries.
+        VerifyOrDie(!aSoftwareReset, OT_EXIT_INVALID_ARGUMENTS);
+        mIsCoprocessorReady = true;
+    }
+    else
+    {
+        ResetCoprocessor(aSoftwareReset);
+    }
     SuccessOrDie(CheckSpinelVersion());
     SuccessOrDie(GetCoprocessorVersion());
     SuccessOrDie(GetCoprocessorCaps());
diff --git a/src/lib/spinel/spinel_driver.hpp b/src/lib/spinel/spinel_driver.hpp
index 1de408b4e..23d23ca6d 100644
--- a/src/lib/spinel/spinel_driver.hpp
+++ b/src/lib/spinel/spinel_driver.hpp
@@ -80,7 +80,8 @@ public:
     CoprocessorType Init(SpinelInterface    &aSpinelInterface,
                          bool                aSoftwareReset,
                          const spinel_iid_t *aIidList,
-                         uint8_t             aIidListLength);
+                         uint8_t             aIidListLength,
+                         bool                aAttachToRunningRcp = false);
 
     /**
      * Deinitialize this SpinelDriver Instance.
diff --git a/src/posix/platform/hdlc_interface.cpp b/src/posix/platform/hdlc_interface.cpp
index 1807e6fd7..835b2bae1 100644
--- a/src/posix/platform/hdlc_interface.cpp
+++ b/src/posix/platform/hdlc_interface.cpp
@@ -53,6 +53,8 @@
 #include <sys/ioctl.h>
 #include <sys/resource.h>
 #include <sys/stat.h>
+#include <sys/socket.h>
+#include <sys/un.h>
 #include <sys/time.h>
 #include <sys/wait.h>
 #include <syslog.h>
@@ -153,7 +155,30 @@ otError HdlcInterface::Init(ReceiveFrameCallback aCallback, void *aCallbackConte
 
     VerifyOrDie(stat(mRadioUrl.GetPath(), &st) == 0, OT_EXIT_ERROR_ERRNO);
 
-    if (S_ISCHR(st.st_mode))
+    if (strcmp(mRadioUrl.GetProtocol(), "spinel+hdlc+unix") == 0)
+    {
+        struct sockaddr_un address;
+        int flags;
+
+        // Ziggurat owns resets and maps ordinary IID 0 traffic to Thread IID 2.
+        VerifyOrExit(mRadioUrl.HasParam("no-reset") && S_ISSOCK(st.st_mode), error = OT_ERROR_INVALID_ARGS);
+        memset(&address, 0, sizeof(address));
+        address.sun_family = AF_UNIX;
+        VerifyOrExit(strlen(mRadioUrl.GetPath()) < sizeof(address.sun_path), error = OT_ERROR_INVALID_ARGS);
+        strcpy(address.sun_path, mRadioUrl.GetPath());
+        mSockFd = socket(AF_UNIX, SOCK_STREAM, 0);
+        VerifyOrExit(mSockFd >= 0, error = OT_ERROR_FAILED);
+        if (connect(mSockFd, reinterpret_cast<struct sockaddr *>(&address), sizeof(address)) != 0 ||
+            (flags = fcntl(mSockFd, F_GETFL, 0)) < 0 ||
+            fcntl(mSockFd, F_SETFL, flags | O_NONBLOCK) < 0 ||
+            fcntl(mSockFd, F_SETFD, FD_CLOEXEC) < 0)
+        {
+            close(mSockFd);
+            mSockFd = -1;
+            ExitNow(error = OT_ERROR_FAILED);
+        }
+    }
+    else if (S_ISCHR(st.st_mode))
     {
         mSockFd = OpenFile(mRadioUrl);
         VerifyOrExit(mSockFd != -1, error = OT_ERROR_FAILED);
@@ -220,6 +245,9 @@ otError HdlcInterface::SendFrame(const uint8_t *aFrame, uint16_t aLength)
     Spinel::FrameBuffer<kMaxFrameSize> encoderBuffer;
     Hdlc::Encoder                      hdlcEncoder(encoderBuffer);
 
+    VerifyOrExit(strcmp(mRadioUrl.GetProtocol(), "spinel+hdlc+unix") != 0 ||
+                     !(aLength >= 2 && aFrame[1] == SPINEL_CMD_RESET),
+                 error = OT_ERROR_INVALID_STATE);
     SuccessOrExit(error = hdlcEncoder.BeginFrame());
     SuccessOrExit(error = hdlcEncoder.Encode(aFrame, aLength));
     SuccessOrExit(error = hdlcEncoder.EndFrame());
@@ -244,7 +272,9 @@ otError HdlcInterface::Write(const uint8_t *aFrame, uint16_t aLength)
 #else
     while (aLength)
     {
-        ssize_t rval = write(mSockFd, aFrame, aLength);
+        ssize_t rval = strcmp(mRadioUrl.GetProtocol(), "spinel+hdlc+unix") == 0
+                           ? send(mSockFd, aFrame, aLength, MSG_NOSIGNAL)
+                           : write(mSockFd, aFrame, aLength);
 
         if (rval == aLength)
         {
@@ -674,7 +704,10 @@ void HdlcInterface::CloseFile(void)
     VerifyOrExit(mSockFd != -1);
 
     VerifyOrExit(0 == close(mSockFd), perror("close RCP"));
-    VerifyOrExit(-1 != wait(nullptr) || errno == ECHILD, perror("wait RCP"));
+    if (strcmp(mRadioUrl.GetProtocol(), "spinel+hdlc+unix") != 0)
+    {
+        VerifyOrExit(-1 != wait(nullptr) || errno == ECHILD, perror("wait RCP"));
+    }
 
     mSockFd = -1;
 
diff --git a/src/posix/platform/radio_url.cpp b/src/posix/platform/radio_url.cpp
index 28edbb231..306c3b423 100644
--- a/src/posix/platform/radio_url.cpp
+++ b/src/posix/platform/radio_url.cpp
@@ -46,6 +46,7 @@ const char *otSysGetRadioUrlHelpString(void)
 #define OT_SPINEL_SPI_RADIO_URL_HELP_BUS                                                                       \
     "Protocol=[spinel+spi*]           Specify the Spinel interface as the Spinel SPI interface\n"              \
     "    spinel+spi://${PATH_TO_SPI_DEVICE}?${Parameters}\n"                                                   \
+    "    spinel+hdlc+unix:///path/to/socket?no-reset (Ziggurat Thread endpoint)\n" \
     "Parameters:\n"                                                                                            \
     "    gpio-int-device[=gpio-device-path]\n"                                                                 \
     "                                  Specify a path to the Linux sysfs-exported GPIO device for the\n"       \
diff --git a/src/posix/platform/spinel_manager.cpp b/src/posix/platform/spinel_manager.cpp
index 761b8fb2d..252f777c2 100644
--- a/src/posix/platform/spinel_manager.cpp
+++ b/src/posix/platform/spinel_manager.cpp
@@ -78,7 +78,8 @@ CoprocessorType SpinelManager::Init(const char *aUrl)
 
     swReset = !mUrl.HasParam("no-reset");
 
-    mode = mSpinelDriver.Init(*mSpinelInterface, swReset, iidList, OT_ARRAY_LENGTH(iidList));
+    mode = mSpinelDriver.Init(*mSpinelInterface, swReset, iidList, OT_ARRAY_LENGTH(iidList),
+                              strcmp(mUrl.GetProtocol(), "spinel+hdlc+unix") == 0);
 
     otLogDebgPlat("instance init:%p - iid = %d", (void *)&mSpinelDriver, iidList[0]);
 
-- 
2.43.0

