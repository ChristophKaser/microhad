From 9f14e649064a3c6bd5404d1be76da30dcac7ee71 Mon Sep 17 00:00:00 2001
From: Christoph Kaser <christoph@caser.de>
Date: Thu, 8 Oct 2026 09:19:28 +0200
Subject: [PATCH] rs-matter: configure regulatory region before credentials

---
 rs-matter/src/onboard.rs | 34 +++++++++++++++++++++++++++++++++-
 1 file changed, 33 insertions(+), 1 deletion(-)

diff --git a/rs-matter/src/onboard.rs b/rs-matter/src/onboard.rs
index f1a5a79b..3e39406c 100644
--- a/rs-matter/src/onboard.rs
+++ b/rs-matter/src/onboard.rs
@@ -62,7 +62,9 @@ use core::num::NonZeroU8;
 
 use crate::cert::gen::Validity;
 use crate::crypto::{Crypto, Rng, AEAD_CANON_KEY_LEN};
-use crate::dm::clusters::gen_comm::{CommissioningErrorEnum, GeneralCommissioningClient};
+use crate::dm::clusters::gen_comm::{
+    CommissioningErrorEnum, GeneralCommissioningClient, RegulatoryLocationTypeEnum,
+};
 use crate::dm::clusters::noc::{NodeOperationalCertStatusEnum, OperationalCredentialsClient};
 use crate::dm::endpoints::ROOT_ENDPOINT_ID;
 use crate::dm::NodeId;
@@ -84,6 +86,13 @@ pub mod noc;
 const NOCSR_TAG_CSR: u8 = 1;
 const NOCSR_TAG_NONCE: u8 = 2;
 
+/// Regulatory settings applied after ArmFailSafe and before attestation/CSR.
+#[derive(Debug, Clone, Copy, Eq, PartialEq, Hash)]
+pub struct RegulatoryConfig {
+    pub country_code: [u8; 2],
+    pub location: RegulatoryLocationTypeEnum,
+}
+
 /// Knobs for [`Commissioner::commission`].
 ///
 /// Per-device material (NodeID, validity) is passed as separate
@@ -96,6 +105,8 @@ pub struct CommissionOptions {
     /// flow must complete before this expires, otherwise the device
     /// rolls back any partial state.
     pub fail_safe_secs: u16,
+    /// Configure radio devices before installing operational credentials.
+    pub regulatory_config: Option<RegulatoryConfig>,
     /// Skip Device Attestation verification.
     ///
     /// Real DCL fetch + cert-chain validation is deferred to a follow-up.
@@ -110,6 +121,7 @@ impl CommissionOptions {
     pub const fn new() -> Self {
         Self {
             fail_safe_secs: 60,
+            regulatory_config: None,
             allow_test_attestation: false,
         }
     }
@@ -396,6 +408,26 @@ impl<'a, 'b, C: Crypto> Commissioner<'a, 'b, C> {
         // `initiate_pase` unless there is one already; the rest reuse it.
         self.arm_fail_safe(peer_addr, passcode, opts.fail_safe_secs)
             .await?;
+        if let Some(config) = opts.regulatory_config {
+            if !config.country_code.iter().all(u8::is_ascii_uppercase) {
+                return Err(ErrorCode::InvalidData.into());
+            }
+            let country = core::str::from_utf8(&config.country_code)
+                .map_err(|_| ErrorCode::InvalidData)?;
+            let response = Exchange::initiate_pase(self.matter, &self.crypto, peer_addr, passcode)
+                .await?
+                .general_commissioning()
+                .set_regulatory_config(ROOT_ENDPOINT_ID, |request| {
+                    request.new_regulatory_config(config.location)?
+                        .country_code(country)?.breadcrumb(0)?.end()
+                })
+                .await?;
+            let status = response.response()?.error_code()?;
+            response.complete().await?;
+            if status != CommissioningErrorEnum::OK {
+                return Err(ErrorCode::Failure.into());
+            }
+        }
 
         // Device Attestation — structural hook. See [`CommissionOptions::allow_test_attestation`].
         self.verify_device_attestation(opts).await?;
-- 
