From 1c0de174bfbc6760dccee9f3956498cbd331f79b Mon Sep 17 00:00:00 2001
From: Christoph Kaser <christoph@caser.de>
Date: Thu, 12 Nov 2026 09:37:50 +0100
Subject: [PATCH] Protect subscribed Matter sessions during eviction

---
 rs-matter/src/transport.rs         | 12 +++++
 rs-matter/src/transport/session.rs | 72 ++++++++++++++++++++++++++++++
 2 files changed, 84 insertions(+)

diff --git a/rs-matter/src/transport.rs b/rs-matter/src/transport.rs
index 18d45bd6..7ec5d9eb 100644
--- a/rs-matter/src/transport.rs
+++ b/rs-matter/src/transport.rs
@@ -2312,6 +2312,11 @@ impl<'a, C: Crypto> TransportRunner<'a, C> {
         encode: bool,
     ) -> Result<bool, Error> {
         self.matter.with_state(|state| {
+            warn!("Session table pressure: used={} capacity={} plaintext={} reserved={} expired={}",
+                state.sessions.iter().count(), crate::transport::session::MAX_SESSIONS,
+                state.sessions.iter().filter(|s| matches!(s.get_session_mode(), crate::transport::session::SessionMode::PlainText)).count(),
+                state.sessions.iter().filter(|s| s.is_reserved()).count(),
+                state.sessions.iter().filter(|s| s.is_expired()).count());
             let id = state
                 .sessions
                 .get_session_for_eviction()
@@ -2342,6 +2347,13 @@ impl<'a, C: Crypto> TransportRunner<'a, C> {
         let mut session = unwrap!(sessions.remove(id));
         self.transport().notify_session_removed();
 
+        warn!(
+            "Session eviction: peer={} node={:?} mode={:?} remaining={} capacity={} bytes_per_session={}",
+            session.get_peer_addr(), session.get_peer_node_id(), session.get_session_mode(),
+            sessions.iter().count(), crate::transport::session::MAX_SESSIONS,
+            core::mem::size_of::<crate::transport::session::Session>()
+        );
+
         debug!(
             "Evicting session {} [SID:{:x},RSID:{:x}]",
             session.id,
diff --git a/rs-matter/src/transport/session.rs b/rs-matter/src/transport/session.rs
index ec1f2972..7a24c619 100644
--- a/rs-matter/src/transport/session.rs
+++ b/rs-matter/src/transport/session.rs
@@ -149,6 +149,8 @@ impl From<&PeerMrpParams> for SessionParameters {
 }
 
 pub struct Session {
+    /// Application hint: this CASE session carries a live subscription.
+    subscription_active: bool,
     // Internal ID which is guaranteeed to be unique accross all sessions and not change when sessions are added/removed
     pub(crate) id: u32,
     peer_addr: Address,
@@ -218,6 +220,7 @@ impl Session {
     ) -> Self {
         Self {
             id,
+            subscription_active: false,
             reserved,
             peer_addr,
             local_nodeid: 0,
@@ -254,6 +257,7 @@ impl Session {
     ) -> impl Init<Self> {
         init!(Self {
             id,
+            subscription_active: false,
             reserved,
             peer_addr,
             local_nodeid: 0,
@@ -322,6 +326,13 @@ impl Session {
         self.peer_nodeid
     }
 
+    /// Prefer disposable sessions over this session under table pressure.
+    /// This is a preference, not a reservation: active exchanges remain the
+    /// only hard exclusion, so subscriptions cannot prevent all progress.
+    pub fn set_subscription_active(&mut self, active: bool) {
+        self.subscription_active = active;
+    }
+
     pub fn get_local_fabric_idx(&self) -> u8 {
         self.mode.fab_idx()
     }
@@ -2039,12 +2050,27 @@ impl Sessions {
     pub fn get_session_for_eviction(&mut self) -> Option<&mut Session> {
         let index = self
             .expired()
+            // A recent abandoned handshake must not displace a sleeping
+            // subscriber simply because the subscriber has been quiet longer.
+            .or_else(|| self.lru(|sess| !matches!(sess.mode, SessionMode::Case { .. })))
+            .or_else(|| self.lru(|sess| !sess.subscription_active && self.has_alternative_case(sess)))
+            .or_else(|| self.lru(|sess| !sess.subscription_active && !self.is_within_fabric_share(sess)))
+            .or_else(|| self.lru(|sess| !sess.subscription_active))
             .or_else(|| self.lru(|sess| !self.is_within_fabric_share(sess)))
             .or_else(|| self.lru(|_| true))?;
 
         Some(&mut self.sessions[index])
     }
 
+    fn has_alternative_case(&self, sess: &Session) -> bool {
+        let SessionMode::Case { fab_idx, .. } = sess.mode else { return false; };
+        self.sessions.iter().any(|other| {
+            other.id != sess.id && !other.reserved && !other.expired
+                && other.peer_nodeid == sess.peer_nodeid
+                && matches!(other.mode, SessionMode::Case { fab_idx: idx, .. } if idx == fab_idx)
+        })
+    }
+
     /// Like [`Self::get_session_for_eviction`], but never picks a live CASE
     /// session, for callers that evict without a `CloseSession` to the peer.
     #[cfg(feature = "groups")]
@@ -2971,6 +2997,52 @@ mod tests {
         assert_eq!(unwrap!(sm.get_session_for_eviction()).id, old);
     }
 
+    #[test]
+    fn eviction_reclaims_handshakes_before_an_over_share_subscriber() {
+        let mut sm = Sessions::new();
+        let mut first = 0;
+        for node in 0..=CASE_SESSIONS_PER_FABRIC {
+            let id = add_for_node(&mut sm, fab(1), node as u64);
+            if node == 0 { first = id; }
+            unwrap!(sm.get(id)).set_subscription_active(true);
+            unwrap!(sm.get(id)).set_last_use(Instant::from_ticks(1));
+        }
+        let handshake = add_with_mode(&mut sm, SessionMode::PlainText);
+        unwrap!(sm.get(handshake)).set_last_use(Instant::from_ticks(10));
+        advance_clock_past(10);
+        assert_eq!(unwrap!(sm.get_session_for_eviction()).id, handshake);
+        // Active exchanges and reserved handshakes remain protected.
+        unwrap!(sm.get(handshake)).reserved = true;
+        assert_eq!(unwrap!(sm.get_session_for_eviction()).id, first);
+    }
+
+    #[test]
+    fn eviction_prefers_unsubscribed_and_duplicate_case_sessions() {
+        let mut sm = Sessions::new();
+        let subscriber = add_for_node(&mut sm, fab(1), 10);
+        unwrap!(sm.get(subscriber)).set_subscription_active(true);
+        unwrap!(sm.get(subscriber)).set_last_use(Instant::from_ticks(1));
+        let ordinary = add_for_node(&mut sm, fab(1), 20);
+        unwrap!(sm.get(ordinary)).set_last_use(Instant::from_ticks(10));
+        advance_clock_past(10);
+        assert_eq!(unwrap!(sm.get_session_for_eviction()).id, ordinary);
+        let duplicate = add_for_node(&mut sm, fab(1), 20);
+        unwrap!(sm.get(duplicate)).set_last_use(Instant::from_ticks(10));
+        assert_eq!(unwrap!(sm.get_session_for_eviction()).id, ordinary);
+        sm.remove(ordinary);
+        assert_eq!(unwrap!(sm.get_session_for_eviction()).id, duplicate);
+        sm.remove(duplicate);
+        assert_eq!(unwrap!(sm.get_session_for_eviction()).id, subscriber,
+            "subscriptions are a preference and cannot exhaust all eviction candidates");
+    }
+
+    #[test]
+    fn session_table_layout() {
+        std::println!("Session={} Sessions={} capacity={} exchanges={}",
+            core::mem::size_of::<Session>(), core::mem::size_of::<Sessions>(),
+            MAX_SESSIONS, MAX_EXCHANGES);
+    }
+
     /// A CASE session within its fabric's share is evicted only when nothing
     /// else can be: a newer session that belongs to no fabric goes first.
     #[test]
