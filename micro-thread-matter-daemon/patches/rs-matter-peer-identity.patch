From 3b0e59ce7b73324f0c8f990c5f9c23ad00cef08e Mon Sep 17 00:00:00 2001
From: Christoph Kaser <christoph@caser.de>
Date: Wed, 7 Oct 2026 16:04:51 +0200
Subject: [PATCH] rs-matter: expose authenticated exchange peer identity

---
 rs-matter-transport/src/exchange.rs | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/rs-matter-transport/src/exchange.rs b/rs-matter-transport/src/exchange.rs
index f106d88a..770c3b70 100644
--- a/rs-matter-transport/src/exchange.rs
+++ b/rs-matter-transport/src/exchange.rs
@@ -1550,6 +1550,14 @@ impl<'a> Exchange<'a> {
             ))
         })
     }
+    /// Return the authenticated peer identity for this exchange.
+    pub fn peer_identity(&self) -> Result<Option<(u8, u64)>, Error> {
+        self.id.with_sessions(self.transport, |sessions| {
+            let session = self.id().session(sessions);
+            Ok(session.get_peer_node_id().map(|node| (session.get_local_fabric_idx(), node)))
+        })
+    }
+
 }
 
 impl Drop for Exchange<'_> {
