From: Christoph Kaser <christoph@caser.de>
Date: Thu, 15 Oct 2026 14:05:00 +0200
Subject: [PATCH] openthread: identify first-fragment conversion failures

Record conversion and reassembly stages and a bounded receive prefix on failure.
Keep each event within OpenThread platform log limits. No protocol changes.

--- a/src/core/thread/mesh_forwarder.cpp
+++ b/src/core/thread/mesh_forwarder.cpp
@@ -1099,6 +1099,7 @@
     Error                  error = kErrorNone;
     Lowpan::FragmentHeader fragmentHeader;
     Message               *message = nullptr;
+    const char            *stage = "fragment_header";
 
     SuccessOrExit(error = fragmentHeader.ParseFrom(aRxInfo.mFrameData));
 
@@ -1141,15 +1142,19 @@
         UpdateEidRlocCacheAndStaleChild(aRxInfo);
 #endif
 
+        stage = "frame_to_message";
         SuccessOrExit(error = FrameToMessage(aRxInfo, datagramSize, message));
 
+        stage = "message_size";
         VerifyOrExit(datagramSize >= message->GetLength(), error = kErrorParse);
+        stage = "extend_message";
         SuccessOrExit(error = message->SetLength(datagramSize));
 
         message->SetDatagramTag(fragmentHeader.GetDatagramTag());
         message->SetTimestampToNow();
         message->UpdateLinkInfoFrom(aRxInfo.mLinkInfo);
 
+        stage = "ingress_filter";
         SuccessOrExit(error = Get<Ip6::Filter>().Apply(*message));
 
 #if OPENTHREAD_FTD
@@ -1217,6 +1222,19 @@
     }
     else
     {
+        if (fragmentHeader.GetDatagramOffset() == 0)
+        {
+            String<65> header;
+            String<17> prefix;
+            uint16_t length = aRxInfo.mFrameData.GetLength();
+            header.AppendHexBytes(aRxInfo.mFrameData.GetBytes(), length < 32 ? length : 32);
+            prefix.AppendHexBytes(Get<Mle::Mle>().GetMeshLocalPrefix().m8, 8);
+            LogInfo("RX first fragment failed stage:%s error:%s tag:%u dglen:%u msglen:%u",
+                    stage, ErrorToString(error), fragmentHeader.GetDatagramTag(), fragmentHeader.GetDatagramSize(),
+                    message == nullptr ? 0 : message->GetLength());
+            LogInfo("RX fragment input tag:%u len:%u header:%s", fragmentHeader.GetDatagramTag(), length, header.AsCString());
+            LogInfo("RX fragment context tag:%u mesh_prefix:%s", fragmentHeader.GetDatagramTag(), prefix.AsCString());
+        }
         LogFragmentFrameDrop(error, aRxInfo, fragmentHeader);
         FreeMessage(message);
     }
@@ -1291,18 +1309,26 @@
     Error             error     = kErrorNone;
     FrameData         frameData = aRxInfo.mFrameData;
     Message::Priority priority;
+    const char       *stage = "priority_headers";
 
     SuccessOrExit(error = GetFramePriority(aRxInfo, priority));
 
+    stage = "allocate";
     aMessage = Get<MessagePool>().Allocate(Message::kTypeIp6, /* aReserveHeader */ 0, Message::Settings(priority));
     VerifyOrExit(aMessage, error = kErrorNoBufs);
 
+    stage = "decompress";
     SuccessOrExit(error = Get<Lowpan::Lowpan>().Decompress(*aMessage, aRxInfo.mMacAddrs, frameData, aDatagramSize));
 
+    stage = "append_payload";
     SuccessOrExit(error = aMessage->AppendData(frameData));
     aMessage->MoveOffset(frameData.GetLength());
 
 exit:
+    if (error != kErrorNone && aDatagramSize != 0)
+    {
+        LogInfo("RX fragment conversion failed stage:%s error:%s dglen:%u", stage, ErrorToString(error), aDatagramSize);
+    }
     return error;
 }
 
