From 441352f776e471d507ba3fc34b40a1426dd5b118 Mon Sep 17 00:00:00 2001
From: Christoph Kaser <christoph@caser.de>
Date: Wed, 7 Oct 2026 16:04:52 +0200
Subject: [PATCH] rs-matter: support sessionless ICD check-ins

---
 rs-matter-node/src/lib.rs | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/rs-matter-node/src/lib.rs b/rs-matter-node/src/lib.rs
index f4e5ae89..94ba235c 100644
--- a/rs-matter-node/src/lib.rs
+++ b/rs-matter-node/src/lib.rs
@@ -141,6 +141,13 @@ pub struct IcdCheckIn {
 }
 
 impl IcdCheckIn {
+    pub fn from_received(fabric: u8, node: u64, payload: &[u8]) -> Result<Self, Error> {
+        if payload.len() > MAX_ICD_CHECK_IN_BYTES { return Err(ErrorCode::InvalidData.into()); }
+        let mut msg = Self { fabric, node, payload: [0; MAX_ICD_CHECK_IN_BYTES], len: payload.len() };
+        msg.payload[..payload.len()].copy_from_slice(payload);
+        Ok(msg)
+    }
+
     pub fn payload(&self) -> &[u8] {
         &self.payload[..self.len]
     }
@@ -190,6 +197,11 @@ impl<'a> Matter<'a> {
         self.icd_check_ins.lock(|queue| queue.borrow_mut().pop_front())
     }
 
+    pub fn queue_sessionless_icd_check_in(&self, payload: &[u8]) -> Result<(), Error> {
+        self.queue_icd_check_in(IcdCheckIn::from_received(0, 0, payload)?);
+        Ok(())
+    }
+
     fn queue_icd_check_in(&self, check_in: IcdCheckIn) {
         self.icd_check_ins.lock(|queue| {
             let mut queue = queue.borrow_mut();
@@ -1249,7 +1261,7 @@ impl crate::sc::AsyncScHandler for Matter<'_> {
     ) -> Result<(), Error> {
         let (fabric, node) = exchange
             .peer_identity()?
-            .ok_or(ErrorCode::InvalidData)?;
+            .unwrap_or((0, 0));
         let payload = exchange.rx()?.payload();
         if payload.len() > MAX_ICD_CHECK_IN_BYTES {
             return Err(ErrorCode::InvalidData.into());
-- 
