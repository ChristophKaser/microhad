diff --git a/rs-matter/src/transport/exchange.rs b/rs-matter/src/transport/exchange.rs
index 02a912df..42fca9bf 100644
--- a/rs-matter/src/transport/exchange.rs
+++ b/rs-matter/src/transport/exchange.rs
@@ -1305,6 +1305,23 @@ impl<'a> Exchange<'a> {
         Self::accept_after(matter, 0).await
     }
 
+    /// Accept only an exchange whose encrypted Matter protocol header matches
+    /// the supplied protocol and opcode. Other pending exchanges stay available
+    /// to the normal responder set.
+    pub async fn accept_matching(
+        matter: &'a Matter<'a>,
+        proto_id: u16,
+        proto_opcode: u8,
+    ) -> Result<Self, Error> {
+        matter
+            .transport()
+            .accept_if(matter, |_, _, packet| {
+                packet.header.proto.proto_id == proto_id
+                    && packet.header.proto.proto_opcode == proto_opcode
+            })
+            .await
+    }
+
     /// Accepts a new responder exchange pending on the provided Matter stack, but only if the
     /// pending exchange was pending for longer than `received_timeout_ms`.
     ///
