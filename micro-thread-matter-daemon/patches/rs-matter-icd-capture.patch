 3 files changed, 114 insertions(+), 3 deletions(-)

diff --git a/rs-matter/src/lib.rs b/rs-matter/src/lib.rs
index 4b14ee41..60ec6618 100644
--- a/rs-matter/src/lib.rs
+++ b/rs-matter/src/lib.rs
@@ -73,6 +73,7 @@ use crate::utils::init::{init, Init};
 use crate::utils::storage::pooled::Buffers;
 use crate::utils::storage::WriteBuf;
 use crate::utils::sync::blocking::Mutex;
+use heapless::Deque;
 
 use rand_core::Rng;
 
@@ -137,6 +138,28 @@ macro_rules! alloc {
 /// The Matter UDP port
 pub const MATTER_PORT: u16 = 5540;
 
+/// Maximum encrypted ICD Check-In payload retained before the controller loop
+/// consumes it.
+pub const MAX_ICD_CHECK_IN_BYTES: usize = 128;
+const MAX_PENDING_ICD_CHECK_INS: usize = 8;
+
+/// Authenticated peer identity and encrypted Check-In payload copied from the
+/// Secure Channel responder. The application-level MIC is verified later by
+/// the ICD client manager.
+#[derive(Clone)]
+pub struct IcdCheckIn {
+    pub fabric: u8,
+    pub node: u64,
+    payload: [u8; MAX_ICD_CHECK_IN_BYTES],
+    len: usize,
+}
+
+impl IcdCheckIn {
+    pub fn payload(&self) -> &[u8] {
+        &self.payload[..self.len]
+    }
+}
+
 /// Device basic commissioning data
 #[derive(Debug, Clone)]
 #[cfg_attr(feature = "defmt", derive(defmt::Format))]
@@ -162,6 +185,8 @@ pub struct Matter<'a> {
     dev_att: &'a dyn DeviceAttestation,
     /// The internal state of the Matter Object, protected by a mutex for concurrent access from different threads and async tasks.
     state: Mutex<RefCell<MatterState>>,
+    /// Bounded handoff of encrypted Check-In payloads to the controller.
+    icd_check_ins: Mutex<RefCell<Deque<IcdCheckIn, MAX_PENDING_ICD_CHECK_INS>>>,
     /// The basic information configuration for this Matter device
     dev_det: &'a BasicInfoConfig<'a>,
     /// The scratch buffer used by the key-value persistence machinery for
@@ -183,6 +208,22 @@ pub struct Matter<'a> {
 }
 
 impl<'a> Matter<'a> {
+    /// Remove the oldest authenticated, encrypted ICD Check-In received by the
+    /// normal Secure Channel responder.
+    pub fn pop_icd_check_in(&self) -> Option<IcdCheckIn> {
+        self.icd_check_ins.lock(|queue| queue.borrow_mut().pop_front())
+    }
+
+    fn queue_icd_check_in(&self, check_in: IcdCheckIn) {
+        self.icd_check_ins.lock(|queue| {
+            let mut queue = queue.borrow_mut();
+            if queue.is_full() {
+                queue.pop_front();
+            }
+            let _ = queue.push_back(check_in);
+        });
+    }
+
     /// Create a new Matter object.
     ///
     /// # Parameters
@@ -201,6 +242,7 @@ impl<'a> Matter<'a> {
         port: u16,
     ) -> Self {
         Self {
+            icd_check_ins: Mutex::new(RefCell::new(Deque::new())),
             state: Mutex::new(RefCell::new(MatterState::new())),
             transport: Transport::new(),
             dev_det,
@@ -235,6 +277,7 @@ impl<'a> Matter<'a> {
         {
             init!(
                 Self {
+                    icd_check_ins <- Mutex::init(RefCell::init(Deque::new())),
                     state <- Mutex::init(RefCell::init(MatterState::init())),
                     transport <- Transport::init(),
                     dev_det,
@@ -251,6 +294,7 @@ impl<'a> Matter<'a> {
         {
             init!(
                 Self {
+                    icd_check_ins <- Mutex::init(RefCell::init(Deque::new())),
                     state <- Mutex::init(RefCell::init(MatterState::init())),
                     transport <- Transport::init(),
                     dev_det,
@@ -1165,6 +1209,30 @@ impl<'a> Matter<'a> {
 /// The internal state of the Matter Object
 ///
 /// Public for unit tests.
+impl crate::sc::AsyncScHandler for Matter<'_> {
+    async fn check_in(
+        &self,
+        exchange: crate::transport::exchange::Exchange<'_>,
+    ) -> Result<(), Error> {
+        let (fabric, node) = exchange
+            .peer_identity()?
+            .ok_or(ErrorCode::InvalidData)?;
+        let payload = exchange.rx()?.payload();
+        if payload.len() > MAX_ICD_CHECK_IN_BYTES {
+            return Err(ErrorCode::InvalidData.into());
+        }
+        let mut check_in = IcdCheckIn {
+            fabric,
+            node,
+            payload: [0; MAX_ICD_CHECK_IN_BYTES],
+            len: payload.len(),
+        };
+        check_in.payload[..payload.len()].copy_from_slice(payload);
+        self.queue_icd_check_in(check_in);
+        Ok(())
+    }
+}
+
 pub struct MatterState {
     /// All fabrics
     pub fabrics: Fabrics,
@@ -1262,6 +1330,28 @@ pub mod test {
     use crate::utils::storage::WriteBuf;
     use crate::Matter;
 
+    #[test]
+    fn icd_check_in_handoff_is_bounded_and_keeps_newest_messages() {
+        let matter = test_matter();
+        for node in 0..=super::MAX_PENDING_ICD_CHECK_INS as u64 {
+            let mut payload = [0; super::MAX_ICD_CHECK_IN_BYTES];
+            payload[0] = node as u8;
+            matter.queue_icd_check_in(super::IcdCheckIn {
+                fabric: 1,
+                node,
+                payload,
+                len: 1,
+            });
+        }
+        for expected_node in 1..=super::MAX_PENDING_ICD_CHECK_INS as u64 {
+            let check_in = matter.pop_icd_check_in().unwrap();
+            assert_eq!(check_in.fabric, 1);
+            assert_eq!(check_in.node, expected_node);
+            assert_eq!(check_in.payload(), &[expected_node as u8]);
+        }
+        assert!(matter.pop_icd_check_in().is_none());
+    }
+
     pub fn test_matter() -> Matter<'static> {
         Matter::new(
             &crate::dm::devices::test::TEST_DEV_DET,
