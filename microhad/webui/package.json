{
  "name": "microhad-webui",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && python3 ../../scripts/licensing/notices.py web --output dist/licenses.html && node scripts/compress-dist.mjs",
    "dev": "vite --host 0.0.0.0",
    "test:history": "python3 ../scripts/test_history_webui.py",
    "test:automation": "node --test test/automation-editor.test.mjs && node test/automation-editor-browser.cjs && python3 ../scripts/test_automation_webui.py"
  },
  "dependencies": {
    "ace-builds": "1.45.2",
    "chart.js": "4.6.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "typescript": "7.0.2",
    "vite": "6.4.5"
  }
}
