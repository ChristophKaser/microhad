# Lexra architecture and compiler selection adapted from jnilo1/rtl8196e-gateway.
# Upstream configuration (pinned revision):
# https://github.com/jnilo1/rtl8196e-gateway/blob/30eb5e5b9ee334d2c6d76812acd4a6cdf2923423/1-Build-Environment/10-lexra-toolchain/crosstool-ng.config
# Local adaptation: stock Linux 3.10.90, uClibc-ng/LinuxThreads instead of musl,
# disabled native TLS/time64/FENV, and repository-local build/install paths.
# See README.md in this directory for configuration and patch provenance.
CT_CONFIG_VERSION="4"
CT_EXPERIMENTAL=y
CT_OBSOLETE=y
CT_ARCH_MIPS=y
CT_ARCH_ARCH="lx4380"
CT_ARCH_BE=y
CT_ARCH_FLOAT_SW=y
CT_ARCH_mips_o32=y
CT_TARGET_VENDOR="lexra"
CT_KERNEL_LINUX=y
CT_LINUX_SRC_CUSTOM=y
CT_LINUX_CUSTOM_LOCATION="@BUILD@/downloads/linux-3.10.90.tar.xz"
CT_LINUX_V_3_10=y
CT_BINUTILS_SRC_CUSTOM=y
CT_BINUTILS_CUSTOM_LOCATION="@BUILD@/binutils-2.45.1"
CT_BINUTILS_V_2_45=y
CT_BINUTILS_PLUGINS=y
CT_LIBC_UCLIBC_NG=y
CT_UCLIBC_NG_V_1_0_54=y
CT_THREADS_LT=y
CT_LIBC_UCLIBC_CONFIG_FILE="@ROOT@/config/crosstool-ng/uclibc.config"
CT_LIBC_UCLIBC_WCHAR=y
CT_LIBC_UCLIBC_IPV6=y
# CT_LIBC_UCLIBC_FENV is not set
CT_CC_GCC=y
CT_GCC_V_15=y
CT_CC_LANG_CXX=y
# CT_CC_GCC_CONFIG_TLS is not set
# CT_CC_GCC_LIBGOMP is not set
# CT_CC_GCC_LIBSANITIZER is not set
CT_PATCH_BUNDLED_LOCAL=y
CT_LOCAL_PATCH_DIR="@BUILD@/patches"
CT_LOCAL_TARBALLS_DIR="@BUILD@/downloads"
CT_SAVE_TARBALLS=y
CT_PREFIX_DIR="@ROOT@/tools/lexra-proof"
CT_WORK_DIR="@BUILD@/ct-work"
CT_PARALLEL_JOBS=8
CT_LOG_PROGRESS_BAR=n
CT_LOG_EXTRA=y
CT_LOG_TO_FILE=y
# CT_LOG_FILE_COMPRESS is not set
# CT_PREFIX_DIR_RO is not set
