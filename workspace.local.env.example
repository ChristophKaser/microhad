# Trusted shell code sourced by host development tools. Keep your copy private:
# cp workspace.local.env.example workspace.local.env && chmod 600 workspace.local.env
# Existing environment variables and explicit command arguments override this file.
# Quote spaces and shell characters. Relative paths start at the workspace root.
GATEWAY_IP=
LAN_INTERFACE=
TOOLCHAIN=rsdk                         # rsdk or crosstool-ng
LINK_MODE=static                      # static or experimental dynamic (rsdk only)
RSDK_ROOT=../rsdk-4.4.7-4181-EB-2.6.30-0.9.30-m32u-140129
CROSSTOOL_NG_ROOT=tools/lexra-proof
STOCK_ROOTFS=build/stock-runtime         # Extracted stock /lib; required for dynamic builds
SSH_PASSWORD_FILE=                     # e.g. ../ssh_password.txt
SSH_PASSWORD=                          # Alternative to SSH_PASSWORD_FILE; quote it.
SSH_USER=root
SSH_PORT=22
SSH_CONNECT_TIMEOUT=8
# Additional shell settings are allowed; tools consume only recognized keys.
