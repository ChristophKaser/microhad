[submodule "gecko-sdk"]
	path = firmware/dependencies/gecko-sdk
	url = https://github.com/SiliconLabs/gecko_sdk.git
[submodule "dependencies/rs-matter"]
	path = micro-thread-matter-daemon/dependencies/rs-matter
	url = https://github.com/project-chip/rs-matter.git
[submodule "dependencies/slc-cli"]
	path = firmware/dependencies/slc-cli
	url = https://github.com/SiliconLabsSoftware/circuitpython_slc_cli_linux.git
[submodule "thread-matter/dependencies/openthread"]
	path = micro-thread-matter-daemon/dependencies/openthread
	url = https://github.com/openthread/openthread.git
[submodule "microhad/dependencies/mbedtls"]
	path = microhad/dependencies/mbedtls
	url = https://github.com/Mbed-TLS/mbedtls.git
[submodule "microhad-lua"]
	path = microhad/dependencies/lua
	url = https://github.com/lua/lua.git
