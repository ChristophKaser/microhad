get_filename_component(RSDK_ROOT "${EXPERIMENT_ROOT}/../rsdk-4.4.7-4181-EB-2.6.30-0.9.30-m32u-140129" ABSOLUTE)
set(CMAKE_C_COMPILER "${RSDK_ROOT}/bin/mips-linux-gcc")
